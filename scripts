# 6. 现状建筑注记解析（砖2 / 砖+2 / 混3 / 破）
# ════════════════════════════════════════════════════════════════════
STRUCT = {"砖": "砖", "混": "混合", "砼": "钢砼", "钢": "钢", "木": "木", "简": "简易", "破": "破损"}
def parse_struct(tokens):
    s = None; fl = None
    for t in tokens:
        for ch in t:
            if ch in STRUCT and s is None: s = STRUCT[ch]
        m = re.search(r"(\d+)", t)
        if m and fl is None: fl = int(m.group(1))
    return s or "", fl or 1

