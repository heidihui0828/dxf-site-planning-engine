def metric_rows(M):
    m = M.metrics(); c = M.controls; P = M.project
    rows = [("用地面积", "%s㎡（%s亩）" % (format(int(P.get("official_area", round(m["site_area"]))), ","), P.get("official_mu", "%.1f" % m["site_mu"])))]
    rows.append(("容积率 FAR", "%.2f  （控制 ≤%s）" % (m["far"], c.get("far_max", "—"))))
    rows.append(("总建筑面积", "%s㎡ （控制 ≤%s）" % (format(round(m["gfa"]), ","), format(c.get("gfa_max", 0), ",") if c.get("gfa_max") else "—")))
    dens = "约%.0f%%" % (100 * m["density"])
    if m["footprint_all"] > m["footprint"] + 1: dens += "（含预留约%.0f%%）" % (100 * m["density_all"])
    rows.append(("建筑密度", dens))
    if c.get("height_max"): rows.append(("建筑限高", "≤%gm（最高%d层）" % (c["height_max"], m["max_floors"])))
    if c.get("green_min"): rows.append(("绿化覆盖率", "≥%.0f%%" % (100 * c["green_min"])))
    if m["rooms"]:
        rows.append(("客房总数", "%d 间" % m["rooms"])); rows.append(("客房均建面", "约%.0f㎡/间" % m["room_avg"]))
    rows.append(("非建设留白率", "约%.0f%%" % (100 * m["open_ratio"])))
    return rows

def schedule_rows(M, ids=None):
    """业态对照表：同 group 的连续建筑合并一行（如 06–13 临溪联排 ×8）。"""
    rows, seen = [], set()
    bl = [b for b in M.buildings if (ids is None or b["id"] in ids) and not b.get("reserve") and b.get("_g") is not None]
    room_cats = M.project.get("room_cats", ["客房"])
    for b in bl:
        if b["id"] in seen: continue
        grp = [x for x in bl if b.get("group") and x.get("group") == b.get("group")] or [b]
        for x in grp: seen.add(x["id"])
        code = grp[0]["id"] if len(grp) == 1 else "%s–%s" % (grp[0]["id"], grp[-1]["id"])
        rooms = sum(x.get("rooms", 0) for x in grp)
        name = b.get("group") or b.get("short", b["name"])
        if b["cat"] in room_cats and rooms: name += " ×%d" % rooms
        gfa = sum(M.gfa(x) for x in grp)
        fls = sorted(set(x.get("floors", 1) for x in grp))
        fl = "%dF" % fls[0] if len(fls) == 1 else "%d–%dF" % (fls[0], fls[-1])
        rows.append((code, b["cat"], name, "%s㎡·%s" % (format(round(gfa), ","), fl), gfa, rooms))
    return rows

