 <div class="card"><h3>导出 / 导入 JSON</h3><button onclick="exportJ()">导出坐标</button><button onclick="copyJ()">复制</button><button onclick="dl()">下载</button><button onclick="importJ()">从文本导入</button>
  <textarea id="out" placeholder="导出后把这段 JSON 发回，用 apply-board 回写模型"></textarea></div>
