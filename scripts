"""
import argparse, json, os, sys
sys.path.insert(0, os.path.dirname(os.path.abspath(__file__)))

def main():
    ap = argparse.ArgumentParser(description="DXF 精确场地规划引擎")
    sp = ap.add_subparsers(dest="cmd", required=True)
    p = sp.add_parser("decode"); p.add_argument("dxf"); p.add_argument("--cm", type=float)
    p = sp.add_parser("freeze"); p.add_argument("model"); p.add_argument("-d", required=True)
    p.add_argument("--protect-buildings", default=""); p.add_argument("--tolerance-mm", type=float, required=True)
    p = sp.add_parser("guard"); p.add_argument("model"); p.add_argument("--report", required=True)
    p = sp.add_parser("freeze-dxf"); p.add_argument("dxf"); p.add_argument("-o", required=True)
    p.add_argument("--units", choices=["m", "mm", "cm", "in", "ft"], required=True)
    p.add_argument("--layer", action="append", required=True); p.add_argument("--tolerance-mm", type=float, required=True)
    p = sp.add_parser("verify-dxf"); p.add_argument("manifest"); p.add_argument("dxf"); p.add_argument("--report", required=True)
    for c in ("summary", "check"): sp.add_parser(c).add_argument("model")
    for c in ("base", "ledger"):
        p = sp.add_parser(c); p.add_argument("model"); p.add_argument("-o", required=True)
    p = sp.add_parser("terrain"); p.add_argument("model"); p.add_argument("-o", required=True); p.add_argument("--section", action="append")
    p = sp.add_parser("board"); p.add_argument("model"); p.add_argument("-o", required=True); p.add_argument("--ids")
    p = sp.add_parser("apply"); p.add_argument("model"); p.add_argument("board_json")
    p = sp.add_parser("plan"); p.add_argument("model"); p.add_argument("-o", required=True)
    p.add_argument("--style", default=None); p.add_argument("--panel", default="metrics"); p.add_argument("--zone"); p.add_argument("--dpi", type=int, default=170)
    p = sp.add_parser("zones"); p.add_argument("model"); p.add_argument("-d", required=True)
    p = sp.add_parser("export"); p.add_argument("model"); p.add_argument("--dxf"); p.add_argument("--xlsx"); p.add_argument("--clip", type=float, default=30)
    p = sp.add_parser("stale"); p.add_argument("dir"); p.add_argument("--old", action="append", required=True)
    a = ap.parse_args()
    from site_guard import freeze_dxf, verify_dxf, freeze_model, preflight, write_json, ensure_output_path

    if a.cmd == "freeze-dxf":
        freeze_dxf(a.dxf, a.o, a.units, a.layer, a.tolerance_mm / 1000)
        print("已建立DXF冻结基准：", a.o); return
    if a.cmd == "verify-dxf":
        if os.path.realpath(a.report) in (os.path.realpath(a.manifest), os.path.realpath(a.dxf)):
            raise ValueError("校验报告不得覆盖输入文件")
        try:
            result = verify_dxf(a.manifest, a.dxf, a.report)
        except (ValueError, OSError, KeyError) as ex:
            write_json(a.report, {"passed": False, "error": str(ex)})
            raise
        print("✓ 所选DXF几何回读一致" if result["passed"] else "校验失败，见："+a.report)
        return 0 if result["passed"] else 2

    if a.cmd == "decode":
        from site_engine import decode_report
        print(decode_report(a.dxf, a.cm)); return
    if a.cmd == "stale":
        from site_export import scan_stale
        hits = scan_stale(a.dir, a.old)
        print("\n".join("%s:%d  %s" % h for h in hits) if hits else "✓ 无旧数字残留"); return

    from site_engine import SiteModel, summary
    M = SiteModel(a.model)
    if a.cmd == "freeze":
        result = freeze_model(M, a.d, [x for x in a.protect_buildings.split(",") if x], a.tolerance_mm/1000)
        print("已冻结底图及指定建筑：", result)
    elif a.cmd == "guard":
        ensure_output_path(M, a.report)
        try:
            base = preflight(M)
            write_json(a.report, {"passed": True, "protected_buildings": base["protected_buildings"], "tolerance_m": base["tolerance_m"]})
        except (ValueError, OSError, KeyError) as ex:
            write_json(a.report, {"passed": False, "error": str(ex)})
            raise
        print("✓ 冻结底图与受保护几何一致")
    elif a.cmd == "summary": print(summary(M))
    elif a.cmd == "check":
        preflight(M)
        print(summary(M)); iss = M.check()
        print("\n".join("[%s] %s" % i for i in iss) if iss else "✓ 校核通过：无重叠/出红线/压水体/超指标")
        return 2 if iss else 0
    elif a.cmd == "base":
        from site_render import render_base; render_base(M, a.o); print(a.o)
    elif a.cmd == "ledger":
        from site_render import render_ledger; render_ledger(M, a.o); print(a.o)
    elif a.cmd == "terrain":
        from site_render import render_terrain
        secs = [tuple((float(v[0]), float(v[1])) for v in [s.split(",")[:2], s.split(",")[2:]]) for s in (a.section or [])] or None
        render_terrain(M, a.o, secs); print(a.o)
    elif a.cmd == "board":
        from site_board import make_board; make_board(M, a.o, ids=a.ids.split(",") if a.ids else None); print(a.o)
    elif a.cmd == "apply":
        n = M.apply_board(json.load(open(a.board_json, encoding="utf-8"))); print("已回写 %d 个体块 → %s" % (n, a.model))
    elif a.cmd == "plan":
        from site_render import render_plan
        render_plan(M, a.o, style=a.style, panel=(None if a.panel == "none" else a.panel), zone=a.zone, dpi=a.dpi); print(a.o)
    elif a.cmd == "zones":
        from site_render import render_plan
        os.makedirs(a.d, exist_ok=True)
        for z in M.m.get("zones", []):
            out = os.path.join(a.d, "分区%s_图则.png" % z["id"]); ind = render_plan(M, out, zone=z["id"]); print(out, "|", ind)
    elif a.cmd == "export":
        from site_export import export_dxf, export_xlsx
        if a.dxf: export_dxf(M, a.dxf, clip=a.clip); print(a.dxf)
        if a.xlsx: export_xlsx(M, a.xlsx); print(a.xlsx)

if __name__ == "__main__":
    try:
        sys.exit(main() or 0)
    except (ValueError, OSError, KeyError) as ex:
        print("校验未通过：%s" % ex, file=sys.stderr)
        sys.exit(2)

# -*- coding: utf-8 -*-
"""
site_engine.py — DXF 精确场地规划引擎 · 核心库
================================================
在真实测绘坐标里做场地规划：读 DXF → 配准 → 解码图层 → 现状台账 → 地形 →
设计模型(site_model.json) → 指标 → 校核。出图见 site_render.py，交付见 site_export.py。

设计原则
- 一切几何都在同一个米制坐标系里（通常 CGCS2000 3°带），拒绝像素目测。
- 一份 site_model.json 是唯一真相源：面积、层数、客房、指标全部由模型计算，
  出图面板与交付表格不手填数字。
- 分享版使用纯合成几何验证（见 references/07_合成示例.md）。

依赖：ezdxf shapely pyproj numpy matplotlib（无需 scipy）
"""
import json, math, os, re
from collections import Counter

import numpy as np
import ezdxf
from shapely.geometry import Polygon, LineString, Point, box, MultiPolygon
from shapely.affinity import rotate
from shapely.ops import unary_union, polygonize
from pyproj import CRS, Transformer

# ════════════════════════════════════════════════════════════════════
# 1. 坐标系
# ════════════════════════════════════════════════════════════════════
def tmerc(cm, ellps="GRS80", x0=500000):
    """高斯-克吕格投影（CGCS2000 用 GRS80；西安80 用 IAU76；北京54 用 krass）。"""
    return CRS.from_proj4("+proj=tmerc +lat_0=0 +lon_0=%s +k=1 +x_0=%s +y_0=0 "
                          "+ellps=%s +units=m +no_defs" % (cm, x0, ellps))

def make_transform(cm_from=None, cm_to=None, ellps="GRS80", zone_prefix=0):
    """返回 f(x,y)->(x,y)。cm 相同或缺省时为恒等；zone_prefix 用于剥离带号（如 X=40xxxxxx）。"""
    def strip(x):
        return x - zone_prefix * 1e6 if zone_prefix else x
    if cm_from is None or cm_to is None or abs(float(cm_from) - float(cm_to)) < 1e-9:
        return lambda x, y: (strip(x), y)
    T = Transformer.from_crs(tmerc(cm_from, ellps), tmerc(cm_to, ellps), always_xy=True)
    return lambda x, y: T.transform(strip(x), y)

def parse_frame_meta(msp):
    """从图框/注记文字自动读：坐标系、中央子午线、高程基准、比例尺。
    ★逐条注记单独解析——注意：把所有注记拼成一串解析时，"中央子午线117"
    会吃掉下一条"1985国家高程基准"的"19"被误读成 117°19′（产生严重偏差）。
    读到的结果仍必须用同名地物校验（validate_registration）。"""
    meta = {}
    for e in msp.query("TEXT MTEXT"):
        try:
            t = e.dxf.text if e.dxftype() == "TEXT" else e.plain_text()
        except Exception:
            continue
        if not t:
            continue
        m = re.search(r"中央子午线\s*[:：]?\s*(\d{3})(?:\s*°\s*(\d{1,2})\s*[′']?|(\d{2})(?!\d))?", t)
        if m and "cm" not in meta:
            mins = m.group(2) or m.group(3)
            meta["cm"] = int(m.group(1)) + (int(mins) / 60.0 if mins else 0.0)
            meta["cm_text"] = t.strip()
        for key, pat in [("crs", r"(2000国家大地坐标系|CGCS2000|1980西安坐标系|西安80|1954北京坐标系|北京54|城建坐标系|独立坐标系)"),
                         ("height_datum", r"(1985国家高程基准|85高程|1956黄海高程|黄海高程)"),
                         ("scale", r"^\s*1\s*[:：]\s*(\d+)\s*$")]:
            mm = re.search(pat, t)
            if mm and key not in meta:
                meta[key] = mm.group(1)
    return meta

def validate_registration(pairs, tol=10.0):
    """同名地物校验：pairs=[(名称,(x1,y1),(x2,y2)),...]，返回每对偏差与是否通过。
    典型同名地物：塘/池心、桥、保留建筑角点、控制点(KZD)。应记录实际控制点误差。"""
    out = []
    for name, a, b in pairs:
        d = math.dist(a, b); out.append((name, round(d, 2), d <= tol))
    return out

def zone_prefix_of(x):
    """X 坐标带带号（如 40512345.6 → 40）。无带号返回 0。"""
    # DXF's uninitialised EXTMIN is commonly 1e20, not a survey zone prefix.
    return int(x // 1e6) if math.isfinite(x) and 1e7 < x < 6.1e7 else 0

def fit_helmert(src_pts, dst_pts):
    """四参数相似变换（平移+旋转+缩放）最小二乘拟合。用于地方/城建独立坐标系
    与国家坐标系之间、或两期测绘之间的配准（需 ≥2 对同名点，建议 ≥4）。
    返回 (f, params, rms)。"""
    S = np.asarray(src_pts, float); D = np.asarray(dst_pts, float)
    A = []; b = []
    for (x, y), (X, Y) in zip(S, D):
        A.append([x, -y, 1, 0]); b.append(X)
        A.append([y, x, 0, 1]); b.append(Y)
    p, *_ = np.linalg.lstsq(np.array(A), np.array(b), rcond=None)
    a, bb, tx, ty = p
    f = lambda x, y: (a * x - bb * y + tx, bb * x + a * y + ty)
    res = [math.hypot(*(np.array(f(x, y)) - np.array([X, Y]))) for (x, y), (X, Y) in zip(S, D)]
    params = {"scale": math.hypot(a, bb), "rot_deg": math.degrees(math.atan2(bb, a)), "tx": tx, "ty": ty}
    return f, params, float(np.sqrt(np.mean(np.square(res))))

# ════════════════════════════════════════════════════════════════════
# 2. 图层语义（南方 CASS / GB/T 20257 地形图图式常用图层码）
# ════════════════════════════════════════════════════════════════════
CASS_LAYERS = {
    "JMD": "居民地（建筑 footprint；闭合线+零散 LINE，需 polygonize）",
    "DLSS": "道路设施（道路边线/中线）",
    "DLDW": "独立地物",
    "SXSS": "水系设施（非闭合=岸线，闭合=塘/池）",
    "DGX": "等高线（高程在 elevation 或顶点 z）",
    "GCD": "高程点（INSERT 属性 height / 插入点 z / 旁注 TEXT）",
    "DMTZ": "地貌土质（坎、陡坎、斜坡、陡崖）",
    "ZBTZ": "植被土质（植被符号 INSERT，可提取现状林木/竹/茶）",
    "GXYZ": "管线设施（电杆、管线）",
    "KZD": "控制点（可作配准同名点）",
    "JJ": "境界线",
    "JZD": "界址点（宗地边界）",
    "ZDH": "宗地号", "MJZJ": "面积注记",
    "TK": "图廓/图框（坐标格网标注、比例尺、坐标系、高程基准）",
    "ZJ": "注记（地名、材质如 水泥/碎石、结构如 砖2）",
    "KCJZD": "勘测定界界址点", "KCYDJ": "勘测定界用地界",
}
def guess_layer(name):
    n = name.upper()
    if "DLTB" in n: return "地类图斑（国土调查）——常被当红线用，但≠出让净用地，须核对"
    for k, v in CASS_LAYERS.items():
        if n == k: return v
    return "未知·需人工确认"

# ════════════════════════════════════════════════════════════════════
# 3. DXF 读取（统一变换到目标坐标系）
# ════════════════════════════════════════════════════════════════════
class DXFSource:
    def __init__(self, path, cm=None, to_cm=None, ellps="GRS80"):
        from site_guard import file_hash, GuardError
        self.path = path
        self.file_sha256_at_read = file_hash(path)
        self.doc = ezdxf.readfile(path)
        if file_hash(path) != self.file_sha256_at_read:
            raise GuardError("读取期间底图发生变化，请重新加载")
        self.msp = self.doc.modelspace()
        self.meta = parse_frame_meta(self.msp)
        self.cm = cm if cm is not None else self.meta.get("cm")
        self.to_cm = to_cm if to_cm is not None else self.cm
        ext = self.doc.header.get("$EXTMIN", (0, 0, 0))
        self.zone_prefix = zone_prefix_of(ext[0]) if ext else 0
        self.T = make_transform(self.cm, self.to_cm, ellps, self.zone_prefix)

    # ---- 基础 ----
    def _pts(self, e):
        return [self.T(p[0], p[1]) for p in e.get_points()]

    def layer_table(self):
        c = Counter((e.dxf.layer, e.dxftype()) for e in self.msp)
        rows = {}
        for (lay, t), n in c.items():
            rows.setdefault(lay, {})[t] = n
        return [(lay, types, guess_layer(lay)) for lay, types in sorted(rows.items(), key=lambda kv: -sum(kv[1].values()))]

    def polys(self, layer, min_area=0.0):
        out = []
        for e in self.msp.query('LWPOLYLINE[layer=="%s"]' % layer):
            if e.closed and len(e.get_points()) >= 3:
                g = Polygon(self._pts(e))
                if not g.is_valid: g = g.buffer(0)
                if g.area > min_area: out.append(g)
        for e in self.msp.query('POLYLINE[layer=="%s"]' % layer):
            if e.is_closed:
                pts = [self.T(v.dxf.location.x, v.dxf.location.y) for v in e.vertices]
                if len(pts) >= 3:
                    g = Polygon(pts).buffer(0)
                    if g.area > min_area: out.append(g)
        return out

    def lines(self, layer, include_closed=False):
        out = []
        for e in self.msp.query('LWPOLYLINE[layer=="%s"]' % layer):
            if include_closed or not e.closed:
                p = self._pts(e)
                if len(p) >= 2: out.append(LineString(p))
        for e in self.msp.query('LINE[layer=="%s"]' % layer):
            out.append(LineString([self.T(e.dxf.start.x, e.dxf.start.y), self.T(e.dxf.end.x, e.dxf.end.y)]))
        for e in self.msp.query('POLYLINE[layer=="%s"]' % layer):
            p = [self.T(v.dxf.location.x, v.dxf.location.y) for v in e.vertices]
            if len(p) >= 2: out.append(LineString(p))
        return out

    def texts(self, layers=None):
        out = []
        for e in self.msp.query("TEXT MTEXT"):
            if layers and e.dxf.layer not in layers:
                continue
            try:
                t = e.dxf.text if e.dxftype() == "TEXT" else e.plain_text()
                x, y = self.T(e.dxf.insert.x, e.dxf.insert.y)
                out.append((x, y, t.strip()))
            except Exception:
                pass
        return out

    def inserts(self, layer):
        return [(*self.T(e.dxf.insert.x, e.dxf.insert.y), e.dxf.name) for e in self.msp.query('INSERT[layer=="%s"]' % layer)]

    # ---- 建筑：闭合多段线 + 零散 LINE polygonize + 去重 ----
    def buildings(self, layer="JMD", min_area=10.0, polygonize_lines=True):
        polys = self.polys(layer, min_area)
        faces = []
        if polygonize_lines:
            segs = [l for l in self.lines(layer)]
            if segs:
                faces = [f for f in polygonize(unary_union(segs)) if f.area > max(min_area, 12)]
        allb = polys + [f for f in faces if not any(f.centroid.within(p) for p in polys)]
        return dedupe_polys(allb)

    # ---- 高程点 ----
    def spot_heights(self, layer="GCD"):
        pts = []
        txt = [(x, y, t) for x, y, t in self.texts([layer]) if re.fullmatch(r"-?\d+(\.\d+)?", t)]
        for e in self.msp.query('INSERT[layer=="%s"]' % layer):
            x, y = self.T(e.dxf.insert.x, e.dxf.insert.y); z = None
            for a in (e.attribs or []):
                if a.dxf.tag.lower() in ("height", "高程", "h", "elev", "z"):
                    try: z = float(a.dxf.text)
                    except ValueError: pass
            if z is None and abs(e.dxf.insert.z) > 1: z = float(e.dxf.insert.z)
            if z is None and txt:
                d, t = min(((math.hypot(x - tx, y - ty), tt) for tx, ty, tt in txt), key=lambda k: k[0])
                if d < 4: z = float(t)
            if z is not None: pts.append((x, y, z))
        if not pts and txt:
            pts = [(x, y, float(t)) for x, y, t in txt]
        return pts

    # ---- 等高线 ----
    def contours(self, layer="DGX"):
        out = []
        for e in self.msp.query('LWPOLYLINE[layer=="%s"]' % layer):
            p = self._pts(e)
            if len(p) >= 2: out.append((float(e.dxf.elevation), LineString(p)))
        for e in self.msp.query('POLYLINE[layer=="%s"]' % layer):
            vs = list(e.vertices)
            if len(vs) >= 2:
                z = float(vs[0].dxf.location.z)
                out.append((z, LineString([self.T(v.dxf.location.x, v.dxf.location.y) for v in vs])))
        return out

# ════════════════════════════════════════════════════════════════════
# 4. 几何工具
# ════════════════════════════════════════════════════════════════════
def rect(cx, cy, rot, w, h):
    """矩形体块。rot 为拖拽板约定：屏幕顺时针为正（= 世界坐标顺时针），故取 -rot。"""
    return rotate(box(cx - w / 2, cy - h / 2, cx + w / 2, cy + h / 2), -rot, origin=(cx, cy))

def dedupe_polys(polys, dist=2.0, darea=10.0):
    out = []
    for g in polys:
        if not any(g.centroid.distance(h.centroid) < dist and abs(g.area - h.area) < darea for h in out):
            out.append(g)
    return out

def nearest_poly(polys, xy, tol=4.0):
    if not polys: return None
    P = Point(xy)
    g = min(polys, key=lambda p: p.centroid.distance(P))
    return g if g.centroid.distance(P) <= tol else None

def channel_from_banks(bank_a, bank_b):
    """两条岸线围成溪流通道。★防反向：两种接法都试，取「本身合法、面积小」者。
    （注意：一侧岸线被反向会造成自缠绕，必须检查拓扑和面积。）"""
    a = list(bank_a.coords); b = list(bank_b.coords)
    cands = [Polygon(a + b), Polygon(a + b[::-1])]
    valid = [p for p in cands if p.is_valid and p.area > 1]
    if valid:
        return min(valid, key=lambda p: p.area)
    return min((p.buffer(0) for p in cands), key=lambda p: p.area)

def principal_angle(g):
    """多边形长轴方向（世界坐标，度，逆时针）。"""
    r = g.minimum_rotated_rectangle; c = list(r.exterior.coords)
    e0 = np.subtract(c[1], c[0]); e1 = np.subtract(c[2], c[1])
    v = e0 if np.hypot(*e0) >= np.hypot(*e1) else e1
    return math.degrees(math.atan2(v[1], v[0]))

def dims(g):
    r = g.minimum_rotated_rectangle; c = list(r.exterior.coords)
    a = math.dist(c[0], c[1]); b = math.dist(c[1], c[2])
    return max(a, b), min(a, b)

def line_tangent_deg(line, xy, half=6.0):
    p0 = line.project(Point(xy))
    a = line.interpolate(max(0, p0 - half)); b = line.interpolate(min(line.length, p0 + half))
    return math.degrees(math.atan2(b.y - a.y, b.x - a.x))

def road_offset_line(roads, y0, y1, step=4.0, dx=3.0):
    """沿主路（取给定路线在各 Y 处的平均 X）偏移 dx 得一条平行线（景观墙/竹屏基线）。"""
    def roadX(Y):
        xs = []
        for r in roads:
            c = list(r.coords)
            for i in range(len(c) - 1):
                (x0, yy0), (x1, yy1) = c[i], c[i + 1]
                if (yy0 - Y) * (yy1 - Y) <= 0 and yy0 != yy1:
                    xs.append(x0 + (x1 - x0) * (Y - yy0) / (yy1 - yy0))
        return sum(xs) / len(xs) if xs else None
    pts = [(roadX(Y) + dx, Y) for Y in np.arange(y0, y1, step) if roadX(Y) is not None]
    return LineString(pts)

def bridge_span(channel, cx, cy, rot, reach=60.0):
    """沿桥轴（rot 为拖拽板约定）量测水面跨度（米）。"""
    ang = math.radians(-rot); dx, dy = math.cos(ang), math.sin(ang)
    ray = LineString([(cx - reach * dx, cy - reach * dy), (cx + reach * dx, cy + reach * dy)])
    inter = ray.intersection(channel)
    return inter.length if not inter.is_empty else 0.0

def fit_bridge(channel, cx, cy, rot, landing=1.0, h=3.5):
    """桥宽 = 实测跨度 + 两端各 landing 米搭岸（搭岸长度按设计要求）。"""
    span = bridge_span(channel, cx, cy, rot)
    return {"cx": cx, "cy": cy, "rot": rot, "w": round(span + 2 * landing, 1), "h": h, "span": round(span, 1)}

