# 5. 地形（TIN 线性插值 + IDW 兜底；无需 scipy）
# ════════════════════════════════════════════════════════════════════
class Terrain:
    def __init__(self, spots, contours=None, method="tin", step=2.0):
        self.spots = [(x, y, z) for x, y, z in spots]
        pts = list(self.spots)
        if contours:
            for z, ln in contours:
                n = max(2, int(ln.length / step))
                for i in range(n + 1):
                    p = ln.interpolate(i / n, normalized=True); pts.append((p.x, p.y, z))
        self.pts = np.array(pts) if pts else np.zeros((0, 3))
        self.method = method
        self._tri = None
        if method == "tin" and len(self.pts) >= 3:
            import matplotlib.tri as mtri
            tri = mtri.Triangulation(self.pts[:, 0], self.pts[:, 1])
            self._tri = mtri.LinearTriInterpolator(tri, self.pts[:, 2])

    def _idw(self, x, y, k=6):
        S = np.array(self.spots) if self.spots else self.pts
        d = np.hypot(S[:, 0] - x, S[:, 1] - y)
        idx = np.argsort(d)[:k]
        if d[idx[0]] < 0.5: return float(S[idx[0], 2])
        w = 1.0 / d[idx] ** 2
        return float(np.sum(w * S[idx, 2]) / np.sum(w))

    def z(self, x, y):
        if self._tri is not None:
            v = self._tri(x, y)
            if not np.ma.is_masked(v): return float(v)
        return self._idw(x, y)

    def grid(self, bounds, cell=2.0):
        x0, y0, x1, y1 = bounds
        xs = np.arange(x0, x1, cell); ys = np.arange(y0, y1, cell)
        X, Y = np.meshgrid(xs, ys)
        if self._tri is not None:
            Z = self._tri(X, Y)
            Z = np.ma.filled(Z, np.nan)
            nan = np.isnan(Z)
            for i, j in zip(*np.where(nan)): Z[i, j] = self._idw(X[i, j], Y[i, j])
        else:
            Z = np.vectorize(self._idw)(X, Y)
        return X, Y, Z

    def slope_pct(self, bounds, cell=2.0):
        X, Y, Z = self.grid(bounds, cell)
        gy, gx = np.gradient(Z, cell)
        return X, Y, Z, np.hypot(gx, gy) * 100.0

    def section(self, p0, p1, n=200):
        L = LineString([p0, p1]); d = np.linspace(0, L.length, n)
        return d, np.array([self.z(*L.interpolate(t).coords[0]) for t in d])

def buildable_platform(terrain, redline, slope_max=15.0, cell=2.0, minus=None):
    """可建平台 = 红线 ∩ 坡度<slope_max − minus（退让带等）。返回 (polygon, slope 统计)。"""
    b = redline.bounds
    X, Y, Z, S = terrain.slope_pct(b, cell)
    cells = [box(x - cell / 2, y - cell / 2, x + cell / 2, y + cell / 2)
             for x, y, s in zip(X.ravel(), Y.ravel(), S.ravel()) if s < slope_max and redline.contains(Point(x, y))]
    plat = unary_union(cells).intersection(redline) if cells else Polygon()
    if minus is not None and not plat.is_empty: plat = plat.difference(minus)
    inside = [s for x, y, s in zip(X.ravel(), Y.ravel(), S.ravel()) if redline.contains(Point(x, y))]
    stats = {"<15%": float(np.mean(np.array(inside) < 15)), "15-25%": float(np.mean((np.array(inside) >= 15) & (np.array(inside) < 25))),
             ">25%": float(np.mean(np.array(inside) >= 25))} if inside else {}
    return plat, stats

