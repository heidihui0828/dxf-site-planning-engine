# 7. SiteModel — 唯一真相源
# ════════════════════════════════════════════════════════════════════
class SiteModel:
    def __init__(self, path):
        self.path = os.path.abspath(path)
        self.dir = os.path.dirname(self.path)
        with open(path, encoding="utf-8") as f:
            self.m = json.load(f)
        M = self.m
        self.project = M.get("project", {})
        to_cm = self.project.get("cm")
        # ---- 数据源 ----
        self.src = {}
        for key, s in M["sources"].items():
            p = s["file"] if os.path.isabs(s["file"]) else os.path.join(self.dir, s["file"])
            self.src[key] = DXFSource(p, cm=s.get("cm"), to_cm=to_cm, ellps=s.get("ellps", "GRS80"))
        # ---- 红线 ----
        R = M["redline"]
        if "coords" in R:
            self.redline = Polygon(R["coords"], holes=R.get("holes"))
        else:
            rl = self.src[R["source"]].polys(R["layer"])
            self.redline = max(rl, key=lambda p: p.area)
        # ---- 水系 ----
        W = M.get("water", {})
        s = self.src[W.get("source", R.get("source", "base"))] if W else None
        self.banks = s.lines(W.get("layer", "SXSS")) if W else []
        self.ponds = s.polys(W.get("layer", "SXSS")) if W else []
        self.channel = Polygon()
        if W.get("channel") == "two_banks" and len(self.banks) >= 2:
            nb = sorted(self.banks, key=lambda l: -l.length)
            i, j = W.get("banks_by_length", [0, 1])
            self.channel = channel_from_banks(nb[i], nb[j])
        # ---- 路 / 地形 ----
        Rd = M.get("roads", {})
        self.roads = []
        if Rd:
            rs = self.src[Rd.get("source", "base")].lines(Rd.get("layer", "DLSS"), include_closed=True)
            self.roads = sorted(rs, key=lambda r: -r.length)[: Rd.get("top", 2)]
        Tt = M.get("terrain", {})
        ts = self.src[Tt.get("source", "base")] if Tt else None
        self.spots = ts.spot_heights(Tt.get("spot_layer", "GCD")) if ts else []
        self.contours = ts.contours(Tt.get("contour_layer", "DGX")) if ts else []
        self.terrain = Terrain(self.spots, self.contours if Tt.get("use_contours", True) else None,
                               method=Tt.get("method", "tin")) if self.spots else None
        # ---- 现状 ----
        self._build_existing()
        # ---- 设计建筑 ----
        self.categories = M.get("categories", {})
        self.buildings = []
        for b in M.get("buildings", []):
            g = self.geom(b.get("geom"))
            self.buildings.append(dict(b, _g=g))
        self.bridges = [dict(br, _g=rect(br["cx"], br["cy"], br["rot"], br["w"], br["h"])) for br in M.get("bridges", [])]
        self.lines_ = {k: LineString(v) for k, v in M.get("lines", {}).items()}
        self.controls = M.get("controls", {})

    # ---- 现状台账 ----
    def _build_existing(self):
        E = self.m.get("existing")
        self.existing = []
        if not E: return
        s = self.src[E["source"]]
        polys = s.buildings(E.get("layer", "JMD"), E.get("min_area", 10))
        clip = self.redline.buffer(E.get("clip_buffer", 3))
        polys = [g for g in polys if clip.contains(g.centroid)]
        polys.sort(key=lambda g: (-round(g.centroid.y / 2), g.centroid.x))
        tx = s.texts(E.get("text_layers", ["JMD", "ZJ"]))
        for extra in E.get("extra", []):
            g = nearest_poly(self.src[extra["source"]].buildings(extra.get("layer", "JMD"), 5), extra["near"], extra.get("tol", 4))
            if g is not None: polys.append(g)
        for i, g in enumerate(polys):
            toks = [t for x, y, t in tx if g.buffer(0.5).contains(Point(x, y))]
            st, fl = parse_struct(toks)
            rec = {"id": "E%02d" % (i + 1), "_g": g, "area": g.area, "struct": st, "floors": fl,
                   "action": E.get("default_action", "拆除"), "label": ""}
            self.existing.append(rec)
        for d in E.get("decisions", []):
            best = min(self.existing, key=lambda r: r["_g"].centroid.distance(Point(d["near"])))
            if best["_g"].centroid.distance(Point(d["near"])) <= d.get("tol", 4):
                best["action"] = d["action"]; best["label"] = d.get("label", "")
                if "floors" in d: best["floors"] = d["floors"]
        for extra in E.get("extra", []):
            for r in self.existing:
                if r["_g"].centroid.distance(Point(extra["near"])) < extra.get("tol", 4):
                    r["action"] = extra.get("action", "保留改造"); r["label"] = extra.get("label", "")
                    if "floors" in extra: r["floors"] = extra["floors"]

    # ---- 几何解析 ----
    def geom(self, spec):
        if not spec: return None
        t = spec["type"]
        if t == "rect": return rect(spec["cx"], spec["cy"], spec["rot"], spec["w"], spec["h"])
        if t == "poly": return Polygon(spec["coords"], holes=spec.get("holes"))
        if t == "existing":
            g = nearest_poly(self.src[spec["source"]].buildings(spec.get("layer", "JMD"), spec.get("min_area", 5)),
                             spec["near"], spec.get("tol", 4))
            if g is None: raise ValueError("existing 几何未找到: %s" % spec)
            return g
        raise ValueError("未知几何类型 %s" % t)

    # ---- 指标 ----
    def gfa(self, b):
        if "gfa_override" in b: return float(b["gfa_override"])
        fp = b.get("area_override") or (b["_g"].area if b.get("_g") is not None else 0)
        return fp * b.get("floors", 1)

    def footprint(self, b):
        return float(b.get("area_override") or (b["_g"].area if b.get("_g") is not None else 0))

    def site_area(self):
        basis = self.project.get("site_area_basis", "redline")
        return float(basis) if isinstance(basis, (int, float)) else self.redline.area

    def metrics(self):
        rows = []
        for b in self.buildings:
            rows.append({"id": b["id"], "name": b["name"], "cat": b["cat"], "kind": b.get("kind", ""),
                         "footprint": self.footprint(b), "floors": b.get("floors", 1), "gfa": self.gfa(b),
                         "rooms": b.get("rooms", 0), "group": b.get("group", ""),
                         "reserve": bool(b.get("reserve") or b.get("_g") is None)})
        A = self.site_area()
        tot_gfa = sum(r["gfa"] for r in rows)
        tot_fp = sum(r["footprint"] for r in rows if not r["reserve"])          # 已落位基底
        tot_fp_all = sum(r["footprint"] for r in rows)                           # 含未落位预留
        rooms = sum(r["rooms"] for r in rows)
        bycat = {}
        for r in rows: bycat[r["cat"]] = bycat.get(r["cat"], 0) + r["gfa"]
        room_gfa = sum(r["gfa"] for r in rows if r["rooms"] or r["cat"] in self.project.get("room_cats", ["客房"]))
        return {"rows": rows, "site_area": A, "site_mu": A / 666.667, "gfa": tot_gfa, "footprint": tot_fp,
                "footprint_all": tot_fp_all, "density_all": tot_fp_all / A,
                "max_floors": max([r["floors"] for r in rows] or [0]),
                "far": tot_gfa / A, "density": tot_fp / A, "rooms": rooms, "by_cat": bycat,
                "room_gfa": room_gfa, "room_avg": room_gfa / rooms if rooms else 0,
                "open_ratio": 1 - tot_fp / A, "controls": self.controls}

    def renewal_stats(self):
        """城市更新口径：留改拆 + 拆除比例 + 拆建比（对照建科〔2021〕63号：拆除≤20%、拆建比≤2，需以地方细则为准）。"""
        ex = sum(r["area"] * r["floors"] for r in self.existing)
        dem = sum(r["area"] * r["floors"] for r in self.existing if r["action"] == "拆除")
        kept = ex - dem
        new = sum(self.gfa(b) for b in self.buildings if "改造" not in b.get("kind", ""))
        return {"existing_gfa": ex, "demolished_gfa": dem, "retained_gfa": kept, "new_gfa": new,
                "demolition_ratio": dem / ex if ex else 0, "rebuild_ratio": new / dem if dem else float("inf"),
                "n_keep": sum(1 for r in self.existing if r["action"] != "拆除"),
                "n_demolish": sum(1 for r in self.existing if r["action"] == "拆除")}

    # ---- 校核（确认门的机器部分） ----
    def check(self, setback=None):
        issues = []
        placed = [b for b in self.buildings if b.get("_g") is not None]
        for i in range(len(placed)):
            for j in range(i + 1, len(placed)):
                a = placed[i]["_g"].intersection(placed[j]["_g"]).area
                if a > 0.5: issues.append(("重叠", "%s × %s 重叠 %.1f㎡" % (placed[i]["id"], placed[j]["id"], a)))
        sb = setback if setback is not None else self.m.get("water", {}).get("setback", 6)
        sbz = self.channel.buffer(sb) if not self.channel.is_empty else None
        for b in placed:
            g = b["_g"]; kind = b.get("kind", "")
            out = g.difference(self.redline).area
            if out > 1 and not b.get("allow_outside"):
                if "改造" in kind: issues.append(("现状出红线", "%s 出红线 %.1f㎡（现状改造·可按 grandfather 保留，需与设计院确认）" % (b["id"], out)))
                else: issues.append(("出红线", "%s 出红线 %.1f㎡" % (b["id"], out)))
            if not self.channel.is_empty:
                w = g.intersection(self.channel).area
                if w > 0.5 and "架空" not in kind: issues.append(("压水体", "%s 压溪流 %.1f㎡" % (b["id"], w)))
                if sbz is not None and "改造" not in kind:
                    s = g.intersection(sbz).area
                    if s > 0.5: issues.append(("进退让带", "%s 进入 %gm 退让带 %.1f㎡ (%.0f%%)%s" % (
                        b["id"], sb, s, 100 * s / g.area, " ·架空设计" if "架空" in kind else "")))
            if "新建" in kind and b["geom"] and b["geom"].get("type") == "existing":
                issues.append(("拆除重建用了原轮廓", "%s 标为新建却引用现状轮廓——拆除重建单元必须用设计 footprint" % b["id"]))
        for br in self.bridges:
            sp = bridge_span(self.channel, br["cx"], br["cy"], br["rot"]) if not self.channel.is_empty else 0
            if sp and br["w"] < sp + 0.5: issues.append(("桥不搭岸", "桥宽 %.1f < 跨度 %.1f" % (br["w"], sp)))
        m = self.metrics(); c = self.controls
        if c.get("far_max") and m["far"] > c["far_max"]: issues.append(("超容积率", "FAR %.2f > %.2f" % (m["far"], c["far_max"])))
        if c.get("gfa_max") and m["gfa"] > c["gfa_max"]: issues.append(("超总建面", "%.0f > %.0f" % (m["gfa"], c["gfa_max"])))
        if c.get("density_max") and m["density"] > c["density_max"]: issues.append(("超密度", "%.1f%%" % (100 * m["density"])))
        return issues

    # ---- 回写（拖拽板导出 JSON → 模型） ----
    def apply_board(self, board_items, save=True):
        from site_guard import preflight, GuardError
        baseline = preflight(self)
        protected = set(baseline["protected_buildings"])
        idx = {b["id"]: b for b in self.m["buildings"]}
        seen = set()
        for it in board_items:
            bid = it["id"]
            if bid in seen: raise GuardError("回写编号重复：%s" % bid)
            seen.add(bid)
            if bid in protected: raise GuardError("禁止拖拽板回写冻结建筑：%s" % bid)
            if bid in idx and (idx[bid].get("geom") or {}).get("type") not in (None, "rect"):
                raise GuardError("禁止把原始多边形/现状轮廓覆盖成矩形：%s" % bid)
            vals = [float(it[k]) for k in ("cx", "cy", "rot", "w", "h")]
            if not all(math.isfinite(v) for v in vals) or vals[-1] <= 0 or vals[-2] <= 0:
                raise GuardError("回写坐标或宽深无效：%s" % bid)
        n = 0
        for it in board_items:
            b = idx.get(it["id"])
            if b is None:
                self.m["buildings"].append({"id": it["id"], "name": it.get("name", it["id"]), "cat": it.get("cat", "客房"),
                                            "floors": it.get("floors", 1), "kind": "新建",
                                            "geom": {"type": "rect", "cx": it["cx"], "cy": it["cy"], "rot": it["rot"], "w": it["w"], "h": it["h"]}})
            else:
                b["geom"] = {"type": "rect", "cx": it["cx"], "cy": it["cy"], "rot": it["rot"],
                             "w": it["w"], "h": it["h"]}
                if "floors" in it: b["floors"] = it["floors"]
            n += 1
        self.buildings = [dict(b, _g=self.geom(b.get("geom"))) for b in self.m.get("buildings", [])]
        preflight(self)
        if save:
            with open(self.path, "w", encoding="utf-8") as f: json.dump(self.m, f, ensure_ascii=False, indent=1)
        return n

    def ground(self, x, y):
        """现状地坪。terrain.ground_method='idw' 时仅用高程点 IDW（与已交付成果口径一致）。"""
        if not self.terrain: return None
        if self.m.get("terrain", {}).get("ground_method") == "idw": return self.terrain._idw(x, y)
        return self.terrain.z(x, y)

    def building(self, bid):
        for b in self.buildings:
            if b["id"] == bid: return b
        return None

