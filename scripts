# 8. 报告
# ════════════════════════════════════════════════════════════════════
def decode_report(path, cm=None):
    s = DXFSource(path, cm=cm)
    lines = ["# 图层解码报告 · %s" % os.path.basename(path),
             "图框元数据: %s" % (s.meta or "（未读到，需人工确认坐标系/中央子午线）"),
             "带号前缀: %s   INSUNITS: %s" % (s.zone_prefix or "无", s.doc.header.get("$INSUNITS")), "",
             "| 图层 | 实体 | 语义猜测 |", "|---|---|---|"]
    for lay, types, sem in s.layer_table():
        lines.append("| %s | %s | %s |" % (lay, ", ".join("%s×%d" % kv for kv in types.items()), sem))
    return "\n".join(lines)

def summary(model):
    m = model.metrics()
    out = ["用地 %.0f㎡ (%.2f亩) | 总建面 %.1f㎡ | FAR %.3f | 基底 %.1f㎡ 密度 %.1f%% | 客房 %d 间 均 %.1f㎡"
           % (m["site_area"], m["site_mu"], m["gfa"], m["far"], m["footprint"], 100 * m["density"], m["rooms"], m["room_avg"])]
    out.append("分类建面: " + "  ".join("%s %.0f" % kv for kv in m["by_cat"].items()))
    if model.existing:
        r = model.renewal_stats()
        out.append("现状 %d 栋(保留改造 %d / 拆除 %d) | 现状建面 %.0f 拆除 %.0f (%.0f%%) 新建 %.0f 拆建比 %.2f"
                   % (len(model.existing), r["n_keep"], r["n_demolish"], r["existing_gfa"], r["demolished_gfa"],
                      100 * r["demolition_ratio"], r["new_gfa"], r["rebuild_ratio"]))
    if not model.channel.is_empty: out.append("溪流通道 %.0f㎡" % model.channel.area)
    return "\n".join(out)

