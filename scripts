"""
site_export.py — 交付设计院：方案 DXF（分图层）+ 逐栋明细 XLSX（公式）+ 旧数字一致性扫描

DXF：R2010(AC1024)，设计院打开即可另存 DWG（DWG 为私有格式，开源库不可靠写出——给 DXF 是行业常规）。
     所有线要素裁到红线外扩 clip 米（否则溪流/退让线会拖出几百米）；等高线写入真实 elevation。
XLSX：建筑面积=占地×层数 用公式；指标汇总用公式引用明细；城市更新另附留改拆统计。
"""
from site_guard import guard_output

import os, re, math
import ezdxf
from ezdxf.enums import TextEntityAlignment
from shapely.geometry import Point, LineString

def _hex2rgb(h):
    h = h.lstrip("#"); return tuple(int(h[i:i + 2], 16) for i in (0, 2, 4))

def _geoms(g):
    return list(g.geoms) if hasattr(g, "geoms") else [g]

def export_dxf(M, out, clip=30.0, font="simsun.ttf", note_extra=None):
    from site_guard import generation_state, checked_save_dxf
    before = generation_state(M)
    doc = ezdxf.new("R2010", setup=True)
    doc.units = 6  # The engine uses metres; never leave export units ambiguous.
    doc.appids.add("SITE_GUARD")
    doc.styles.add("HZ", font=font)
    msp = doc.modelspace()
    cats = list(M.categories.keys())
    L = {"red": "00-用地红线"}
    for i, c in enumerate(cats, 1): L["cat:" + c] = "%02d-建筑-%s" % (i, M.categories[c].get("label", c))
    k = len(cats)
    L.update({"keep": "%02d-现状-保留改造" % (k + 1), "demo": "%02d-现状-拆除" % (k + 2), "num": "%02d-建筑编号" % (k + 3),
              "ann": "%02d-建筑标注" % (k + 4), "grd": "%02d-竖向-现状地坪标高" % (k + 5)})
    sb = M.m.get("water", {}).get("setback", 6); fe = M.m.get("water", {}).get("fence", 2)
    L.update({"water": "20-水体", "bank": "21-岸线", "sb": "22-退让线-%gm" % sb, "fence": "23-围栏线-%gm" % fe,
              "road": "30-道路", "bridge": "31-桥", "dgx": "40-等高线", "gcd": "41-高程点", "note": "50-说明"})
    for key, ln in M.lines_.items(): L["line:" + key] = "32-%s" % M.m.get("line_labels", {}).get(key, key)
    aci = {"red": 1, "keep": 3, "demo": 1, "num": 7, "ann": 8, "grd": 6, "water": 5, "bank": 5, "sb": 30, "fence": 2,
           "road": 30, "bridge": 40, "dgx": 8, "gcd": 8, "note": 7}
    for key, name in L.items():
        lay = doc.layers.add(name, color=aci.get(key, 7))
        if key.startswith("cat:"): lay.rgb = _hex2rgb(M.categories[key[4:]].get("color", "#3a3d3f"))
        if key.startswith("line:"): lay.color = 6
    def T(x, y, t, lay, h=1.6, al=TextEntityAlignment.MIDDLE_CENTER):
        e = msp.add_text(t, height=h, dxfattribs={"layer": lay, "style": "HZ"}); e.set_placement((x, y), align=al)
    def pl(coords, lay, closed=False, elev=None, key=None):
        a = {"layer": lay}
        if elev is not None: a["elevation"] = elev
        e = msp.add_lwpolyline(list(coords), close=closed, dxfattribs=a)
        if key is not None: e.set_xdata("SITE_GUARD", [(1000, key)])
    def shape(g, lay, key):
        if g is None or g.is_empty: return
        if hasattr(g, "geoms"):
            for i, p in enumerate(g.geoms): shape(p, lay, "%s/%s" % (key, i))
        else:
            pl(g.exterior.coords, lay, True, key=key+"/outer")
            for i, ring in enumerate(g.interiors): pl(ring.coords, lay, True, key=key+"/hole/%s" % i)
    CLIP = M.redline.buffer(clip)
    shape(M.redline, L["red"], "redline")
    # 设计建筑
    for b in M.buildings:
        g = b.get("_g")
        if g is None: continue
        shape(g, L["cat:" + b["cat"]], "building/"+b["id"])
        c = g.centroid; T(c.x, c.y, b["id"], L["num"], 2.2)
        txt = "%s / %s / %d层 / 建面%s㎡" % (b["name"], b.get("kind", ""), b.get("floors", 1), format(round(M.gfa(b)), ","))
        if b.get("rooms"): txt += " / %d间" % b["rooms"]
        T(c.x, c.y - 3.2, txt, L["ann"], 1.1)
        if M.terrain: T(c.x, c.y - 5.0, "现状地坪 %.2f" % M.ground(c.x, c.y), L["grd"], 1.1)
    # 现状留改拆
    for e in M.existing:
        lay = L["demo"] if e["action"] == "拆除" else L["keep"]
        shape(e["_g"], lay, "existing/"+e["id"])
        c = e["_g"].centroid
        T(c.x, c.y, ("拆 " if e["action"] == "拆除" else "留 ") + e["id"], lay, 1.3)
    # 水系 / 退让 / 围栏（全部裁切）
    ch = M.channel.intersection(CLIP) if not M.channel.is_empty else None
    if ch is not None:
        for p in _geoms(ch):
            if p.geom_type == "Polygon" and p.area > 1: pl(p.exterior.coords, L["water"], True)
        for d, key in ((sb, "sb"), (fe, "fence")):
            for ln in _geoms(M.channel.buffer(d).exterior.intersection(CLIP)):
                if ln.geom_type == "LineString" and not ln.is_empty: pl(ln.coords, L[key])
    for p in M.ponds:
        if p.intersects(CLIP): pl(p.exterior.coords, L["water"], True)
    for b in M.banks:
        for ln in _geoms(b.intersection(CLIP)):
            if ln.geom_type == "LineString" and not ln.is_empty: pl(ln.coords, L["bank"])
    for r in M.roads:
        for ln in _geoms(r.intersection(CLIP)):
            if ln.geom_type == "LineString" and not ln.is_empty: pl(ln.coords, L["road"])
    for i, br in enumerate(M.bridges, 1):
        shape(br["_g"], L["bridge"], "bridge/%s" % (i-1)); c = br["_g"].centroid; T(c.x, c.y, "桥%d" % i, L["bridge"], 1.4)
    for key, ln in M.lines_.items():
        for s in _geoms(ln.intersection(CLIP)):
            if s.geom_type == "LineString" and not s.is_empty: pl(s.coords, L["line:" + key])
    # 地形
    for z, ln in M.contours:
        for s in _geoms(ln.intersection(CLIP)):
            if s.geom_type == "LineString" and not s.is_empty and s.length > 3:
                pl(s.coords, L["dgx"], elev=z)
                if z % 2 == 0:
                    p = s.interpolate(0.5, normalized=True); T(p.x, p.y, "%g" % z, L["dgx"], 1.0)
    for x, y, z in M.spots:
        if CLIP.contains(Point(x, y)):
            msp.add_point((x, y, z), dxfattribs={"layer": L["gcd"]}); T(x + 0.6, y, "%.2f" % z, L["gcd"], 0.9, TextEntityAlignment.LEFT)
    # 说明（数字全部来自模型）
    m = M.metrics(); P = M.project; x0, y0, x1, y1 = M.redline.bounds
    info = ["%s · %s" % (P.get("name", ""), P.get("dxf_title", "方案总平面")),
            "坐标系: %s" % P.get("crs_label", ""),
            "用地面积 %s㎡（红线实测）" % format(round(M.redline.area), ","),
            "总建筑面积 %s㎡  容积率 %.2f" % (format(round(m["gfa"]), ","), m["far"]),
            "建筑基底 %s㎡  密度 %.1f%%" % (format(round(m["footprint"]), ","), 100 * m["density"])]
    if m["rooms"]: info.append("客房 %d 间  均 %.0f㎡/间" % (m["rooms"], m["room_avg"]))
    info.append("分类建面: " + "  ".join("%s %s" % (M.categories.get(c, {}).get("label", c), format(round(v), ",")) for c, v in m["by_cat"].items()))
    if M.terrain: info.append("竖向标注为实测现状地坪(高程点+等高线插值)，±0.00 由设计院竖向设计确定")
    info += (note_extra or [])
    for i, t in enumerate(info): T(x0 - 20, y1 + 25 - i * 3.2, t, L["note"], 2.0, TextEntityAlignment.LEFT)
    checked_save_dxf(doc, out, M, L, before)
    return {k: v for k, v in L.items()}

