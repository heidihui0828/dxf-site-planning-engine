svg.addEventListener('pointerup',()=>{drag=null;});
svg.addEventListener('pointerdown',ev=>{if(!meas)return;const p=pt(ev);mpts.push(p);if(mpts.length>2)mpts=[p];drawMeas();});
function drawMeas(){MG.innerHTML='';for(const p of mpts){const [x,y]=w2s(...p);MG.innerHTML+=`<circle cx="${x}" cy="${y}" r="4" fill="#1f4e79"/>`;}
 if(mpts.length==2){const [a,b]=mpts.map(p=>w2s(...p));const d=Math.hypot(mpts[1][0]-mpts[0][0],mpts[1][1]-mpts[0][1]);
 MG.innerHTML+=`<line x1="${a[0]}" y1="${a[1]}" x2="${b[0]}" y2="${b[1]}" stroke="#1f4e79" stroke-width="2" stroke-dasharray="6 3"/><text x="${(a[0]+b[0])/2+6}" y="${(a[1]+b[1])/2-6}" fill="#1f4e79" font-size="15" font-weight="700">${d.toFixed(2)} m</text>`;}}
function measToggle(){meas=!meas;mpts=[];drawMeas();document.getElementById('mbtn').classList.toggle('on',meas);}
function rot(d){if(!sel)return;sel.rot=+((sel.rot+d+540)%360-180).toFixed(1);refresh();}
function snap(){if(!sel||!C.refs.length)return;let best=C.refs[0],bd=1e9;for(const r of C.refs){for(const k of [0,180,-180]){const d=Math.abs(sel.rot-(r+k));if(d<bd){bd=d;best=r+k;}}}sel.rot=+best.toFixed(1);refresh();}
function dup(){if(!sel)return;const n=Object.assign({},sel);let k=2;while(B.some(b=>b.id==sel.id+'-'+k))k++;n.id=sel.id+'-'+k;n.cx+=3;n.cy-=3;B.push(n);sel=n;refresh();}
