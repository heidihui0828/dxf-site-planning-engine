
"""Run a portable synthetic workflow without touching bundled examples."""
import argparse
import json
from pathlib import Path
import shutil
import subprocess
import sys


def main():
    parser = argparse.ArgumentParser(description="合成场地安装自检；输出目录须为新目录")
    parser.add_argument("--output", required=True)
    args = parser.parse_args()
    skill = Path(__file__).resolve().parents[1]
    output = Path(args.output).resolve()
    output.mkdir(parents=True, exist_ok=False)
    stages = []

    def run(label, arguments, expected=0):
        result = subprocess.run([sys.executable, str(skill / "scripts/site_cli.py")] +
                                [str(x) for x in arguments], capture_output=True, text=True,
                                encoding="utf-8", errors="replace")
        stages.append({"stage": label, "exit_code": result.returncode,
                       "expected_exit_code": expected, "passed": result.returncode == expected})
        (output / (label + ".log")).write_text(result.stdout + result.stderr, encoding="utf-8")
        if result.returncode != expected:
            raise RuntimeError(label + " failed; see output log")

    try:
        import ezdxf
        for name in ("demo_base.dxf", "demo_site_model.json"):
            shutil.copy2(skill / "examples" / name, output / name)
        base = output / "demo_base.dxf"
        model = output / "demo_site_model.json"
        run("01_decode", ["decode", base])
        run("02_freeze", ["freeze", model, "-d", output / "frozen", "--protect-buildings", "01", "--tolerance-mm", "1"])
        run("03_guard", ["guard", model, "--report", output / "preflight.json"])
        run("04_check", ["check", model])
        run("05_base", ["base", model, "-o", output / "base.png"])
        run("06_plan", ["plan", model, "-o", output / "plan.png"])
        run("07_board", ["board", model, "-o", output / "board.html"])
        run("08_export", ["export", model, "--dxf", output / "plan.dxf", "--xlsx", output / "schedule.xlsx"])
        manifest = output / "standalone.json"
        run("09_freeze_dxf", ["freeze-dxf", base, "-o", manifest, "--units", "m", "--layer", "EXISTING", "--tolerance-mm", "1"])
        doc = ezdxf.readfile(base)
        doc.saveas(output / "roundtrip.dxf")
        run("10_roundtrip", ["verify-dxf", manifest, output / "roundtrip.dxf", "--report", output / "roundtrip_check.json"])
        doc.modelspace().query('LWPOLYLINE[layer=="EXISTING"]')[0].translate(.1, 0, 0)
        doc.saveas(output / "intentionally_changed.dxf")
        run("11_reject_change", ["verify-dxf", manifest, output / "intentionally_changed.dxf", "--report", output / "rejected_change.json"], expected=2)
        for name in ("preflight.json", "roundtrip_check.json", "base.png.geometry-check.json", "plan.png.geometry-check.json", "board.html.geometry-check.json", "plan.dxf.geometry-check.json", "schedule.xlsx.geometry-check.json"):
            if json.loads((output / name).read_text(encoding="utf-8"))["passed"] is not True:
                raise RuntimeError("Report failed: " + name)
        if json.loads((output / "rejected_change.json").read_text(encoding="utf-8"))["passed"] is not False:
            raise RuntimeError("Intentional geometry change was not rejected")
        if ezdxf.readfile(output / "plan.dxf").units != 6:
            raise RuntimeError("Export units are not metres")
        summary = {"passed": True, "data": "synthetic only", "stages": stages,
                   "note": "The intentional change must fail; open base.png and plan.png for visual inspection."}
    except Exception as exc:
        summary = {"passed": False, "stages": stages, "error": str(exc)}
    (output / "demo_result.json").write_text(json.dumps(summary, ensure_ascii=False, indent=2) + "\n", encoding="utf-8")
    print(json.dumps(summary, ensure_ascii=False, indent=2))
    return 0 if summary["passed"] else 1


if __name__ == "__main__":
    sys.exit(main())

# -*- coding: utf-8 -*-
"""
site_board.py — 交互拖拽落位板（自由落位不猜坐标）

自由落位原则：院落、建筑组团和桥等，凡"自由落位"的元素，手猜坐标必漂。
正解：生成本拖拽板 → 甲方/设计师亲手拖准 → 导出 JSON → apply_board 回写模型 → 出正式图。

功能：拖动、旋转(按钮/[ ]键/Shift×5)、方向键微移(0.1m/Shift 1m)、改宽深层数、复制、删除、
      量距(点两点)、对齐参考角(溪流/道路切向与既有体块角)、实时校核(重叠/出红线/压水体/
      总建面/FAR)、导出/导入 JSON。
坐标约定：rot = 屏幕顺时针为正（与 site_engine.rect 一致），cx/cy/w/h 单位米。
"""
from site_guard import guard_output

import json, math
from shapely.geometry import Point
from site_engine import principal_angle, line_tangent_deg

def _path(coords, S, X0, Y1, close=True):
    pts = ["%.1f %.1f" % ((x - X0) * S, (Y1 - y) * S) for x, y in coords]
    return "M" + " L".join(pts) + (" Z" if close else "")

def _norm(a):
    a = (a + 90) % 180 - 90
    return round(a, 1)

@guard_output
def make_board(M, out, ids=None, extra=None, title=None, width_px=1100, pad=15, contours=True):
    """ids: 放入板中可拖动的建筑 id 列表（默认=所有 rect 类建筑）；extra: 追加新块
    [{id,name,cat,cx,cy,rot,w,h,floors}]。其余建筑作为灰色背景参照。"""
    from site_guard import preflight, GuardError
    protected = set(preflight(M)["protected_buildings"])
    if ids and set(ids) & protected: raise GuardError("冻结建筑不能进入可拖拽清单")
    if any(e["id"] in protected for e in (extra or [])): raise GuardError("新增体块不得复用冻结编号")
    x0, y0, x1, y1 = M.redline.bounds
    X0, X1, Y0, Y1 = x0 - pad, x1 + pad, y0 - pad, y1 + pad
    S = width_px / (X1 - X0); H = (Y1 - Y0) * S
    base = []
    if contours:
        for z, ln in M.contours:
            base.append('<path d="%s" stroke="#d8cdb8" stroke-width="0.6" fill="none"/>' % _path(ln.coords, S, X0, Y1, False))
    def poly(g, **st):
        for p in (g.geoms if hasattr(g, "geoms") else [g]):
            if p.geom_type == "Polygon" and not p.is_empty:
                path = _path(p.exterior.coords, S, X0, Y1) + " ".join(_path(r.coords, S, X0, Y1) for r in p.interiors)
                base.append('<path d="%s" fill-rule="evenodd" %s/>' % (path, " ".join('%s="%s"' % (k.replace("_", "-"), v) for k, v in st.items())))
    poly(M.redline.buffer(0), fill="#f3f1ea", stroke="none")
    if not M.channel.is_empty:
        poly(M.channel, fill="#b9d3e3", stroke="none")
        sb = M.m.get("water", {}).get("setback", 6)
        for p in (M.channel.buffer(sb).geoms if hasattr(M.channel.buffer(sb), "geoms") else [M.channel.buffer(sb)]):
            base.append('<path d="%s" stroke="#e08a3c" stroke-width="1" stroke-dasharray="4 3" fill="none"/>' % _path(p.exterior.coords, S, X0, Y1))
    for p in M.ponds: poly(p, fill="#b9d3e3", stroke="#6f94ad", stroke_width="0.8")
    for r in M.roads: base.append('<path d="%s" stroke="#b0a892" stroke-width="3" fill="none" stroke-linecap="round"/>' % _path(r.coords, S, X0, Y1, False))
    for e in M.existing:
        if e["action"] == "拆除": poly(e["_g"], fill="none", stroke="#d98880", stroke_width="0.9", stroke_dasharray="3 2")
        else: poly(e["_g"], fill="#cfe3dc", stroke="#2e8b57", stroke_width="1")
    rects = [b for b in M.buildings if b.get("geom") and b["geom"].get("type") == "rect"]
    board_ids = (set(ids) if ids else set(b["id"] for b in rects)) - protected
    fixed_gfa = 0.0; blocks = []
    for b in M.buildings:
        if b["id"] in board_ids and b.get("geom") and b["geom"].get("type") == "rect":
            g = b["geom"]
            blocks.append({"id": b["id"], "name": b["name"], "cat": b["cat"], "cx": g["cx"], "cy": g["cy"], "rot": g["rot"],
                           "w": g["w"], "h": g["h"], "floors": b.get("floors", 1),
                           "color": M.categories.get(b["cat"], {}).get("color", "#3a3d3f")})
        else:
            fixed_gfa += M.gfa(b)
            if b.get("_g") is not None: poly(b["_g"], fill="#8f8b84", stroke="#555", stroke_width="0.5", opacity="0.75")
    for br in M.bridges: poly(br["_g"], fill="#b5a98e", stroke="#7a6f57", stroke_width="0.8")
    base.append('<path d="%s" stroke="#c0392b" stroke-width="2" fill="none"/>' % _path(M.redline.exterior.coords, S, X0, Y1))
    for e in (extra or []):
        e = dict(e); e.setdefault("floors", 1); e["color"] = M.categories.get(e.get("cat", ""), {}).get("color", "#b8860b"); blocks.append(e)
    # 参考角：既有体块长轴 + 溪流/道路切向
    refs = set()
    for b in M.buildings:
        if b.get("_g") is not None: refs.add(_norm(-principal_angle(b["_g"])))
    c = M.redline.centroid
    for ln in M.banks[:2] + M.roads[:2]:
        try: refs.add(_norm(-line_tangent_deg(ln, (c.x, c.y), 10)))
        except Exception: pass
    refs = sorted(refs)
    red = [list(p) for p in M.redline.exterior.coords]
    chan = [list(p) for p in M.channel.exterior.coords] if (not M.channel.is_empty and M.channel.geom_type == "Polygon") else []
    cfg = {"S": S, "X0": X0, "Y1": Y1, "W": width_px, "H": H, "blocks": blocks, "fixed": fixed_gfa, "site": M.site_area(),
           "farmax": M.controls.get("far_max", 0), "gfamax": M.controls.get("gfa_max", 0), "refs": refs, "red": red, "chan": chan}
    html = TEMPLATE.replace("__TITLE__", title or ("%s · 交互拖拽落位板" % M.project.get("name", ""))) \
                   .replace("__BASE__", "\n".join(base)).replace("__CFG__", json.dumps(cfg, ensure_ascii=False)) \
                   .replace("__W__", "%.0f" % width_px).replace("__H__", "%.0f" % H)
    with open(out, "w", encoding="utf-8") as f: f.write(html)
    return out

