def _draw_building(ax, g, col, allbuild, texture=True):
    sh = translate(g, 0.9, -1.1).difference(allbuild)
    _poly(ax, sh, fc="#4a463e", ec="none", alpha=0.15, zorder=6)
    _poly(ax, g, fc=col, ec="#16181a", lw=0.5, zorder=7)
    if not texture: return
    r = g.minimum_rotated_rectangle; cs = list(r.exterior.coords)
    e0 = np.subtract(cs[1], cs[0]); e1 = np.subtract(cs[2], cs[1])
    if np.hypot(*e0) >= np.hypot(*e1): longv, shortv, S, base = e0, e1, np.hypot(*e1), np.array(cs[0])
    else: longv, shortv, S, base = e1, e0, np.hypot(*e0), np.array(cs[1])
    n = max(2, int(S // 1.8))
    for k in range(1, n):
        p0 = base + shortv * (k / n)
        _line(ax, LineString([p0, p0 + longv]).intersection(g), color="#2a2c2e", lw=0.4, alpha=0.45, zorder=7.5)

