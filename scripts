def _landscape(ax, M, allbuild, rng, style):
    L = M.m.get("landscape", {})
    red = M.redline; chan = M.channel
    def grove(poly):
        poly = poly.difference(allbuild.buffer(1))
        if not chan.is_empty: poly = poly.difference(chan.buffer(2))
        for g in (poly.geoms if hasattr(poly, "geoms") else [poly]):
            if g.is_empty or g.geom_type != "Polygon" or g.area < 8: continue
            _poly(ax, g, fc=BAMBOO, ec="none", alpha=0.55, zorder=2)
            mnx, mny, mxx, mxy = g.bounds
            for _ in range(int(g.area / 9)):
                x, y = rng.uniform(mnx, mxx), rng.uniform(mny, mxy)
                if g.contains(Point(x, y)): ax.add_patch(Circle((x, y), rng.uniform(0.6, 1.0), fc=BAMBOO_DOT, ec="none", alpha=0.5, zorder=2.1))
    if style != "traffic":
        for s in L.get("bamboo", []):
            t = s["type"]
            if t == "line_buffer": g = LineString(s["coords"]).buffer(s.get("r", 4.5)).intersection(red.buffer(-s.get("clip_in", 1)))
            elif t == "redline_frame": g = red.buffer(-s.get("outer", 1)).difference(red.buffer(-s.get("inner", 7)))
            elif t == "polygon": g = Polygon(s["coords"]).intersection(red.buffer(-s.get("clip_in", 2)))
            else: continue
            grove(g)
    # 水体
    _poly(ax, chan, fc=WATER, ec="none", zorder=3)
    for p in M.ponds: _poly(ax, p, fc=WATER, ec=BANK, lw=0.6, zorder=3)
    for b in M.banks: _line(ax, b, color=BANK, lw=1.0, zorder=4)
    if style == "traffic": return
    if L.get("fence", True) and not chan.is_empty:
        f = chan.buffer(M.m.get("water", {}).get("fence", 2))
        for p in (f.geoms if hasattr(f, "geoms") else [f]): ax.plot(*p.exterior.xy, color="#b6a890", lw=0.6, ls=(0, (2, 2)), zorder=4)
    # 茶梯田（区域内等高线）
    T = L.get("terraces")
    if T and M.contours:
        reg = Polygon(T["region"]).intersection(red.buffer(-2))
        for z, ln in M.contours:
            if T["elev"][0] <= z <= T["elev"][1]: _line(ax, ln.intersection(reg), color="#9a8c66", lw=0.7, alpha=0.5, zorder=2.5)
    # 溪岸院子带（贴水围栏线与退让线之间，逐栋前）
    C = L.get("stream_courts")
    if C and not chan.is_empty:
        band = chan.buffer(C.get("outer", 6)).difference(chan.buffer(C.get("inner", 2)))
        for bid in C["ids"]:
            b = M.building(bid)
            if not b or b.get("_g") is None: continue
            vc = band.intersection(b["_g"].buffer(C.get("reach", 5.5))).difference(allbuild)
            for g in (vc.geoms if hasattr(vc, "geoms") else [vc]):
                if g.geom_type == "Polygon" and g.area > 3:
                    _poly(ax, g, fc=PAVE, ec=PAVE_EDGE, lw=0.4, zorder=3.4)
    for p in L.get("paths", []):
        _poly(ax, LineString(p["coords"]).buffer(p.get("w", 2.0)).difference(allbuild), fc=PAVE, ec="none", alpha=0.75, zorder=3.5)

def _tree_ok(M, P, allbuild):
    if not M.redline.buffer(-3).contains(P): return False
    if not M.channel.is_empty and M.channel.buffer(2).contains(P): return False
    if any(r.buffer(3.0).contains(P) for r in M.roads): return False
    if allbuild.buffer(1.2).contains(P): return False
    return all(not p.buffer(3).contains(P) for p in M.ponds)

def _details(ax, M, allbuild, style):
    L = M.m.get("landscape", {})
    if style == "traffic": return
    for ic in L.get("inner_courts", []):
        g = rect(**ic["rect"]); k = ic.get("fill", "paving")
        fc, ec = {"water": (WATER, BANK), "paving": (PAVE, "#bcb4a2"), "dry": ("#cdd2c0", "#aeb39c")}[k]
        _poly(ax, g, fc=fc, ec=ec, lw=0.5, zorder=8)
        for t in ic.get("trees", []): ax.add_patch(Circle(tuple(t[:2]), t[2], fc=TREE, ec=TREE_EDGE, lw=0.4, alpha=0.9, zorder=8.1))
        for s in ic.get("stones", []): ax.add_patch(Circle(tuple(s[:2]), s[2], fc="#9a958c", ec="#7a756c", lw=0.3, zorder=8.1))
    n = 0
    for t in L.get("trees", []):
        P = Point(t[:2])
        if _tree_ok(M, P, allbuild):
            r = t[2] if len(t) > 2 else 2.2
            ax.add_patch(Circle(tuple(t[:2]), r, fc=TREE, ec=TREE_EDGE, lw=0.5, alpha=0.92, zorder=6.8))
            ax.add_patch(Circle(tuple(t[:2]), 0.35, fc=TRUNK, ec="none", zorder=6.9)); n += 1
    for f in L.get("features", []):
        t = f["type"]
        if t == "court_area":
            geo = [LineString(f["path"]).buffer(f.get("w", 5.0))] + [rect(**r) for r in f.get("rects", [])] + [Point(c[:2]).buffer(c[2]) for c in f.get("circles", [])]
            g = unary_union(geo).intersection(M.redline.buffer(-1))
            for bid in f.get("minus_ids", []):
                bb = M.building(bid)
                if bb and bb.get("_g") is not None: g = g.difference(bb["_g"].buffer(0.4))
            _poly(ax, g, fc=PAVE, ec=PAVE_EDGE, lw=0.5, zorder=5.5)
        elif t == "path_line": ax.plot(*LineString(f["coords"]).xy, color="#c6bfae", lw=f.get("lw", 4), solid_capstyle="round", zorder=6)
        elif t == "pool": _poly(ax, rect(**f["rect"]), fc=WATER, ec="#8aa0a6", lw=0.8, zorder=6.2)
        elif t == "stepping":
            ipc = rect(**f["pool_rect"]).intersection(LineString(f["path"]))
            if not ipc.is_empty:
                for s in np.linspace(0.3, 0.7, f.get("n", 3)):
                    P = ipc.interpolate(s, normalized=True); ax.add_patch(Circle((P.x, P.y), 0.45, fc="#b6b2aa", ec="#9a958c", lw=0.4, zorder=8))
        elif t == "wall":
            gx, gy = f["center"]; a = math.radians(-f.get("rot", 0)); tx, ty = math.cos(a), math.sin(a)
            Lh, gp = f.get("len", 3.3), f.get("gap", 0.7)
            for s in (-1, 1): ax.plot([gx + s * gp * tx, gx + s * Lh * tx], [gy + s * gp * ty, gy + s * Lh * ty], color="#56524a", lw=3.5, solid_capstyle="round", zorder=7.5)
        elif t == "tree":
            ax.add_patch(Circle(tuple(f["xy"]), f.get("r", 2.2), fc=TREE, ec=TREE_EDGE, lw=0.5, alpha=0.93, zorder=7))
            ax.add_patch(Circle(tuple(f["xy"]), 0.35, fc=TRUNK, ec="none", zorder=8))
        elif t == "dot": ax.add_patch(Circle(tuple(f["xy"]), f.get("r", 1.2), fc="#b3ada0", ec="#8c867a", lw=0.5, zorder=7.5))
    return n

