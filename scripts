def _poly(ax, g, **kw):
    for p in (g.geoms if hasattr(g, "geoms") else [g]):
        if p.is_empty or p.geom_type != "Polygon": continue
        if p.interiors:
            from matplotlib.path import Path
            from matplotlib.patches import PathPatch
            from shapely.geometry.polygon import orient
            p = orient(p, sign=1.0)
            vertices, codes = [], []
            for ring in [p.exterior] + list(p.interiors):
                coords = list(ring.coords)
                vertices.extend(coords)
                codes.extend([Path.MOVETO]+[Path.LINETO]*(len(coords)-2)+[Path.CLOSEPOLY])
            ax.add_patch(PathPatch(Path(vertices, codes), **kw))
        else:
            ax.add_patch(MPoly(list(p.exterior.coords), closed=True, **kw))

def _line(ax, g, **kw):
    for l in (g.geoms if hasattr(g, "geoms") else [g]):
        if l.geom_type == "LineString" and not l.is_empty: ax.plot(*l.xy, **kw)

def _wrap(t, n):
    out, line = [], ""
    for ch in t:
        line += ch
        if len(line) >= n: out.append(line); line = ""
    if line: out.append(line)
    return out

def _view(M, zoom, pad=12):
    if zoom: return zoom
    x0, y0, x1, y1 = M.redline.bounds
    return (x0 - pad, x1 + pad, y0 - pad, y1 + pad)

def _north_scale(ax, view, full):
    x0, x1, y0, y1 = view; w, h = x1 - x0, y1 - y0
    nx, ny = x1 - 0.05 * w, y1 - 0.07 * h
    ax.annotate("", xy=(nx, ny), xytext=(nx, ny - 0.06 * h), arrowprops=dict(arrowstyle="-|>", color=INK2, lw=2.2), zorder=12)
    ax.text(nx, ny + 0.012 * h, "N", fontsize=18 if full else 13, ha="center", fontproperties=ZB, color=INK2, zorder=12)
    L = 50 if w > 150 else (20 if w > 60 else 10)
    sx, sy = x0 + 0.04 * w, y0 + 0.03 * h
    ax.plot([sx, sx + L], [sy, sy], color=INK2, lw=3.0, zorder=12, solid_capstyle="butt")
    for t in (0, L / 2, L): ax.plot([sx + t, sx + t], [sy, sy + 0.006 * h], color=INK2, lw=1.2, zorder=12)
    ax.text(sx + L / 2, sy + 0.012 * h, "0      %g      %g m" % (L / 2, L), fontsize=12 if full else 9, ha="center", fontproperties=ZR, color=INK2, zorder=12)

