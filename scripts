# ─────────────────────────── 工序1 地形：坡度分级 + 剖面 ───────────────────────────
@guard_output
def render_terrain(M, out, sections=None, cell=2.0, dpi=150):
    if M.terrain is None: raise ValueError("模型无地形数据（terrain.spot_layer）")
    b = M.redline.bounds
    X, Y, Z, S = M.terrain.slope_pct((b[0] - 10, b[1] - 10, b[2] + 10, b[3] + 10), cell)
    cls = np.where(S < 15, 0, np.where(S < 25, 1, 2)).astype(float)
    mask = np.array([[not M.redline.buffer(5).contains(Point(x, y)) for x, y in zip(rx, ry)] for rx, ry in zip(X, Y)])
    cls[mask] = np.nan
    if not sections:
        cx, cy = M.redline.centroid.x, M.redline.centroid.y
        sections = [((b[0] - 5, cy), (b[2] + 5, cy))]
    fig = plt.figure(figsize=(18, 11)); fig.patch.set_facecolor("#fbfaf6")
    ax = fig.add_axes([0.02, 0.04, 0.46, 0.9])
    from matplotlib.colors import ListedColormap
    ax.pcolormesh(X, Y, cls, cmap=ListedColormap(["#cfe0b8", "#f0d58c", "#e39b86"]), shading="auto", zorder=1)
    for z, ln in M.contours: ax.plot(*ln.xy, color="#8a7a60", lw=0.4, alpha=0.6, zorder=2)
    _poly(ax, M.channel, fc="#9dc3dc", ec="none", zorder=3)
    for e in M.existing: _poly(ax, e["_g"], fc="none", ec="#333", lw=0.6, zorder=4)
    ax.plot(*M.redline.exterior.xy, color="#c0392b", lw=1.8, zorder=5)
    for i, (p0, p1) in enumerate(sections):
        ax.plot([p0[0], p1[0]], [p0[1], p1[1]], color="#1f4e79", lw=1.4, ls="--", zorder=6)
        ax.text(p0[0], p0[1] + 2, "剖%d" % (i + 1), fontsize=11, fontproperties=ZB, color="#1f4e79", zorder=6)
    ax.set_aspect("equal"); ax.set_xlim(b[0] - 10, b[2] + 10); ax.set_ylim(b[1] - 10, b[3] + 10); ax.axis("off")
    inside = S[~mask]
    ax.set_title("坡度分级  <15%% 可建 %.0f%% ｜ 15–25%% 慎建 %.0f%% ｜ >25%% 景观资源 %.0f%%" % (
        100 * np.mean(inside < 15), 100 * np.mean((inside >= 15) & (inside < 25)), 100 * np.mean(inside >= 25)), fontproperties=ZB, fontsize=13)
    n = len(sections)
    for i, (p0, p1) in enumerate(sections):
        a2 = fig.add_axes([0.53, 0.08 + (n - 1 - i) * (0.86 / n), 0.44, 0.86 / n - 0.07])
        d, z = M.terrain.section(p0, p1)
        a2.fill_between(d, z.min() - 3, z, color="#d9cbb0"); a2.plot(d, z, color="#5c4a32", lw=1.6)
        L = LineString([p0, p1])
        for bb in M.buildings:
            g = bb.get("_g")
            if g is None or not g.intersects(L): continue
            seg = g.intersection(L)
            segs = [s_ for s_ in (seg.geoms if hasattr(seg, "geoms") else [seg]) if s_.geom_type == "LineString"]
            if not segs: continue
            t0 = min(L.project(Point(c_)) for s_ in segs for c_ in s_.coords); t1 = max(L.project(Point(c_)) for s_ in segs for c_ in s_.coords)
            inside = z[(d >= t0) & (d <= t1)]
            zlo = float(inside.min()) if inside.size else M.terrain.z(*L.interpolate((t0 + t1) / 2).coords[0])
            zhi = float(inside.max()) if inside.size else zlo
            hgt = bb.get("floors", 1) * M.project.get("floor_height", 3.6)
            a2.add_patch(Rectangle((t0, zlo), t1 - t0, hgt, fc="#3a3d3f", alpha=0.75))
            a2.text((t0 + t1) / 2, zlo + hgt + 0.4, bb["id"] + ("  △%.1fm" % (zhi - zlo) if zhi - zlo > 1.5 else ""), fontsize=8, ha="center", fontproperties=ZB)
        if not M.channel.is_empty and M.channel.intersects(L):
            w = M.channel.intersection(L)
            for s in (w.geoms if hasattr(w, "geoms") else [w]):
                if s.geom_type == "LineString":
                    t0, t1 = L.project(Point(s.coords[0])), L.project(Point(s.coords[-1]))
                    a2.axvspan(min(t0, t1), max(t0, t1), color="#9dc3dc", alpha=0.6)
        a2.set_title("剖%d  高差 %.1fm（最低 %.1f / 最高 %.1f）" % (i + 1, z.max() - z.min(), z.min(), z.max()), fontproperties=ZB, fontsize=11)
        a2.set_xlabel("距离 m", fontproperties=ZR); a2.set_ylabel("高程 m", fontproperties=ZR); a2.grid(alpha=0.3)
    fig.savefig(out, dpi=dpi, facecolor="#fbfaf6"); plt.close(fig)

def main():
    parser = argparse.ArgumentParser(description="合成场地安装自检；输出目录须为新目录")
    parser.add_argument("--output", required=True)
    args = parser.parse_args()
    skill = Path(__file__).resolve().parents[1]
    output = Path(args.output).resolve()
    output.mkdir(parents=True, exist_ok=False)
    stages = []

    def run(label, arguments, expected=0):
        result = subprocess.run([sys.executable, str(skill / "scripts/site_cli.py")] +
                                [str(x) for x in arguments], capture_output=True, text=True,
                                encoding="utf-8", errors="replace")
        stages.append({"stage": label, "exit_code": result.returncode,
                       "expected_exit_code": expected, "passed": result.returncode == expected})
        (output / (label + ".log")).write_text(result.stdout + result.stderr, encoding="utf-8")
        if result.returncode != expected:
            raise RuntimeError(label + " failed; see output log")

    try:
        import ezdxf
        for name in ("demo_base.dxf", "demo_site_model.json"):
            shutil.copy2(skill / "examples" / name, output / name)
        base = output / "demo_base.dxf"
        model = output / "demo_site_model.json"
        run("01_decode", ["decode", base])
        run("02_freeze", ["freeze", model, "-d", output / "frozen", "--protect-buildings", "01", "--tolerance-mm", "1"])
        run("03_guard", ["guard", model, "--report", output / "preflight.json"])
        run("04_check", ["check", model])
        run("05_base", ["base", model, "-o", output / "base.png"])
        run("06_plan", ["plan", model, "-o", output / "plan.png"])
        run("07_board", ["board", model, "-o", output / "board.html"])
        run("08_export", ["export", model, "--dxf", output / "plan.dxf", "--xlsx", output / "schedule.xlsx"])
        manifest = output / "standalone.json"
        run("09_freeze_dxf", ["freeze-dxf", base, "-o", manifest, "--units", "m", "--layer", "EXISTING", "--tolerance-mm", "1"])
        doc = ezdxf.readfile(base)
        doc.saveas(output / "roundtrip.dxf")
        run("10_roundtrip", ["verify-dxf", manifest, output / "roundtrip.dxf", "--report", output / "roundtrip_check.json"])
        doc.modelspace().query('LWPOLYLINE[layer=="EXISTING"]')[0].translate(.1, 0, 0)
        doc.saveas(output / "intentionally_changed.dxf")
        run("11_reject_change", ["verify-dxf", manifest, output / "intentionally_changed.dxf", "--report", output / "rejected_change.json"], expected=2)
        for name in ("preflight.json", "roundtrip_check.json", "base.png.geometry-check.json", "plan.png.geometry-check.json", "board.html.geometry-check.json", "plan.dxf.geometry-check.json", "schedule.xlsx.geometry-check.json"):
            if json.loads((output / name).read_text(encoding="utf-8"))["passed"] is not True:
                raise RuntimeError("Report failed: " + name)
        if json.loads((output / "rejected_change.json").read_text(encoding="utf-8"))["passed"] is not False:
            raise RuntimeError("Intentional geometry change was not rejected")
        if ezdxf.readfile(output / "plan.dxf").units != 6:
            raise RuntimeError("Export units are not metres")
        summary = {"passed": True, "data": "synthetic only", "stages": stages,
                   "note": "The intentional change must fail; open base.png and plan.png for visual inspection."}
    except Exception as exc:
        summary = {"passed": False, "stages": stages, "error": str(exc)}
    (output / "demo_result.json").write_text(json.dumps(summary, ensure_ascii=False, indent=2) + "\n", encoding="utf-8")
    print(json.dumps(summary, ensure_ascii=False, indent=2))
    return 0 if summary["passed"] else 1


if __name__ == "__main__":
    sys.exit(main())
