<script>
const C=__CFG__; let B=C.blocks, sel=null, drag=null, meas=false, mpts=[];
const svg=document.getElementById('svg'), G=document.getElementById('blocks'), MG=document.getElementById('meas');
const w2s=(x,y)=>[(x-C.X0)*C.S,(C.Y1-y)*C.S];
function corners(b){const a=-b.rot*Math.PI/180,c=Math.cos(a),s=Math.sin(a),hw=b.w/2,hh=b.h/2;
 return [[-hw,-hh],[hw,-hh],[hw,hh],[-hw,hh]].map(([u,v])=>[b.cx+u*c-v*s,b.cy+u*s+v*c]);}
function pip(p,poly){let inside=false;for(let i=0,j=poly.length-1;i<poly.length;j=i++){const [xi,yi]=poly[i],[xj,yj]=poly[j];
 if(((yi>p[1])!=(yj>p[1]))&&(p[0]<(xj-xi)*(p[1]-yi)/(yj-yi)+xi))inside=!inside;}return inside;}
function sat(A,Bp){for(const P of [A,Bp]){for(let i=0;i<P.length;i++){const p1=P[i],p2=P[(i+1)%P.length];const nx=p2[1]-p1[1],ny=p1[0]-p2[0];
 let a0=1e18,a1=-1e18,b0=1e18,b1=-1e18;for(const q of A){const d=q[0]*nx+q[1]*ny;a0=Math.min(a0,d);a1=Math.max(a1,d);}
 for(const q of Bp){const d=q[0]*nx+q[1]*ny;b0=Math.min(b0,d);b1=Math.max(b1,d);} if(a1<=b0+1e-6||b1<=a0+1e-6)return false;}}return true;}
