 if(ev.key=='ArrowLeft')sel.cx-=s;else if(ev.key=='ArrowRight')sel.cx+=s;else if(ev.key=='ArrowUp')sel.cy+=s;else if(ev.key=='ArrowDown')sel.cy-=s;
 else if(ev.key=='[')return rot(ev.shiftKey?-5:-1);else if(ev.key==']')return rot(ev.shiftKey?5:1);else return;ev.preventDefault();sel.cx=+sel.cx.toFixed(2);sel.cy=+sel.cy.toFixed(2);refresh();});
for(const [id,k] of [['fx','cx'],['fy','cy'],['fr','rot'],['fw','w'],['fh','h'],['ff','floors']])
 document.getElementById(id).addEventListener('change',e=>{if(!sel)return;sel[k]=parseFloat(e.target.value);refresh();});
function refresh(){draw();const f=(id,v)=>document.getElementById(id).value=v;
 if(sel){document.getElementById('selname').innerHTML=`<b>${sel.id}</b> ${sel.name||''}`;f('fx',sel.cx);f('fy',sel.cy);f('fr',sel.rot);f('fw',sel.w);f('fh',sel.h);f('ff',sel.floors||1);}
 let g=C.fixed,bad=[];for(const b of B){g+=b.w*b.h*(b.floors||1);const p=problems(b);if(p.length)bad.push(`${b.id}：${p.join('、')}`);}
 const far=g/C.site;let h=`总建面 <b>${g.toFixed(0)}</b> ㎡`+(C.gfamax?` / 控制 ${C.gfamax}`:'')+`<br>FAR <b class="${C.farmax&&far>C.farmax?'bad':'ok'}">${far.toFixed(3)}</b>`+(C.farmax?` / 控制 ${C.farmax}`:'');
 h+=bad.length?`<div class="bad" style="margin-top:6px">⚠ ${bad.join('<br>⚠ ')}</div>`:'<div class="ok" style="margin-top:6px">✓ 无重叠 · 无出红线 · 无压水体</div>';
 document.getElementById('stat').innerHTML=h;
 document.getElementById('list').innerHTML=B.map((b,i)=>`<div class="${b===sel?'sel':''}" onclick="sel=B[${i}];refresh()">${b.id}　${b.name||''}　${b.w}×${b.h}×${b.floors||1}F</div>`).join('');}
function payload(){return JSON.stringify(B.map(b=>({id:b.id,name:b.name,cat:b.cat,cx:+(+b.cx).toFixed(2),cy:+(+b.cy).toFixed(2),rot:+(+b.rot).toFixed(1),w:+b.w,h:+b.h,floors:+(b.floors||1)})),null,1);}
function exportJ(){document.getElementById('out').value=payload();}
function copyJ(){exportJ();const t=document.getElementById('out');t.select();navigator.clipboard&&navigator.clipboard.writeText(t.value);}
function dl(){const a=document.createElement('a');a.href=URL.createObjectURL(new Blob([payload()],{type:'application/json'}));a.download='board_export.json';a.click();}
function importJ(){try{const arr=JSON.parse(document.getElementById('out').value);for(const it of arr){const b=B.find(x=>x.id==it.id);if(b)Object.assign(b,it);else B.push(Object.assign({color:'#b8860b'},it));}refresh();}catch(e){alert('JSON 格式有误：'+e);}}
refresh();
</script></body></html>"""

# -*- coding: utf-8 -*-
"""
site_cli.py — DXF 精确场地规划引擎 命令行

  python site_cli.py decode  <file.dxf> [--cm 117]          工序0 图层解码报告（自动读图框坐标系）
