  <div><button onclick="rot(-15)">↺15</button><button onclick="rot(-5)">↺5</button><button onclick="rot(-1)">↺1</button><button onclick="rot(1)">↻1</button><button onclick="rot(5)">↻5</button><button onclick="rot(15)">↻15</button></div>
