def scan_stale(root, patterns, exts=(".md", ".html", ".txt", ".csv", ".json")):
    """交付前扫描旧数字残留：patterns 为旧值列表（如 ['旧指标','旧面积']）。"""
    hits = []
    for dp, _, fs in os.walk(root):
        for f in fs:
            if not f.lower().endswith(exts): continue
            p = os.path.join(dp, f)
            try: txt = open(p, encoding="utf-8").read()
            except Exception: continue
            for pat in patterns:
                for mm in re.finditer(re.escape(pat), txt):
                    line = txt.count("\n", 0, mm.start()) + 1
                    hits.append((os.path.relpath(p, root), line, pat))
    return hits

"""Geometry preservation gates. Tolerances are metres, never drawing pixels.

The baseline is evidence, not a security boundary. No automatic re-baselining,
alignment, scaling, healing, or silent skipping of unsupported geometry.
"""
import copy
import hashlib
import json
import math
import os
from pathlib import Path
import shutil
import tempfile
from collections import Counter, defaultdict
from functools import wraps

import ezdxf

VERSION = "geometry-guard/1"
UNITS = {"m": (6, 1.0), "mm": (4, .001), "cm": (5, .01),
         "in": (1, .0254), "ft": (2, .3048)}
ANNOTATIONS = {"TEXT", "MTEXT", "DIMENSION", "ATTRIB", "ATTDEF"}


class GuardError(ValueError):
    pass


def digest(value):
    return hashlib.sha256(json.dumps(value, ensure_ascii=False, sort_keys=True,
                                     allow_nan=False, separators=(",", ":")).encode()).hexdigest()


def file_hash(path):
    h = hashlib.sha256()
    with open(path, "rb") as f:
        for chunk in iter(lambda: f.read(1024 * 1024), b""):
            h.update(chunk)
    return h.hexdigest()


def write_json(path, data, exclusive=False):
    path = Path(path)
    path.parent.mkdir(parents=True, exist_ok=True)
    with path.open("x" if exclusive else "w", encoding="utf-8") as f:
        json.dump(data, f, ensure_ascii=False, indent=2, allow_nan=False)
        f.write("\n")


def seal(data):
    return dict(data, integrity=digest(data))


def load_baseline(path, expected_hash=None):
    if expected_hash and file_hash(path) != expected_hash:
        raise GuardError("冻结清单已改变；不得改写旧基准来消除失败，请另建经确认的新版本")
    data = json.loads(Path(path).read_text(encoding="utf-8"))
    integrity = data.pop("integrity", None)
    if integrity != digest(data) or data.get("version") != VERSION:
        raise GuardError("冻结清单校验失败或版本不支持")
    return data


def tolerance(value):
    value = float(value)
    if not math.isfinite(value) or value <= 0:
        raise GuardError("须明确填写正数几何容差（米），它是数字文件保真阈值，不是施工允许偏差")
    return value


def unit_factor(doc, units):
    if units not in UNITS:
        raise GuardError("未声明或不支持的单位：%s" % units)
    code, factor = UNITS[units]
    actual = int(doc.header.get("$INSUNITS", 0))
    if actual not in (0, code):
        raise GuardError("单位冲突：声明%s，DXF $INSUNITS=%s；不得自动猜测或缩放" % (units, actual))
    return factor, actual


def record(key, layer, kind, points=(), lengths=(), params=(), flags=()):
    r = {"id": str(key), "layer": layer, "kind": kind,
         "points": [[float(c) for c in p] for p in points],
         "lengths": list(map(float, lengths)), "params": list(map(float, params)),
         "flags": list(flags)}
    # Reject NaN and infinity before any comparison (NaN can mask a failure).
    json.dumps(r, allow_nan=False)
    return r


def dxf_snapshot(doc, units, layers=None):
    """Extract WCS primitives. INSERTs are expanded in memory, never in source.

    Vertex order/type must be preserved. Entity handles are diagnostic only;
    a third-party re-tessellation requires review instead of a false pass.
    """
    factor, code = unit_factor(doc, units)
    wanted = set(layers) if layers is not None else None
    if wanted is not None and not wanted:
        raise GuardError("冻结图层范围不能为空")
    rows, annotations, errors = [], Counter(), []
    selected_roots = Counter()

    def vec(v):
        p = list(v)
        return [float(c) * factor for c in (p + [0.0] * (3-len(p)))[:3]]

    def walk(e, key, inherited="0", force=False, depth=0):
        layer = e.dxf.layer if e.dxf.layer != "0" else inherited
        selected = force or wanted is None or layer in wanted
        if selected:
            selected_roots[layer] += 1
        kind = e.dxftype()
        if kind == "INSERT":
            if depth > 24:
                errors.append("%s：块嵌套过深/循环" % key); return
            # Xrefs or empty blocks cannot silently count as verified.
            block = e.block()
            if block is None or len(block) == 0:
                if selected: errors.append("%s：空块或未解析外部参照" % key)
                return
            try:
                inserts = e.multi_insert() if e.mcount > 1 else [e]
                for n, ins in enumerate(inserts):
                    skipped = []
                    children = list(ins.virtual_entities(skipped_entity_callback=lambda obj, why: skipped.append((obj, why))))
                    if skipped:
                        errors.append("%s：块展开未完整 %s" % (key, [why for _, why in skipped]))
                    for j, child in enumerate(children):
                        walk(child, "%s/%s/%s" % (key, n, j), layer, selected, depth+1)
            except Exception as ex:
                errors.append("%s：块变换失败 %s" % (key, ex))
            return
        if not selected:
            return
        if kind in ANNOTATIONS:
            annotations[kind] += 1
            return
        try:
            if e.dxf.get("thickness", 0):
                raise GuardError("带厚度的实体尚未覆盖")
            if kind == "LINE":
                row = record(key, layer, kind, [vec(e.dxf.start), vec(e.dxf.end)])
            elif kind == "POINT":
                row = record(key, layer, kind, [vec(e.dxf.location)])
            elif kind == "LWPOLYLINE":
                vertices = list(e.get_points("xyseb"))
                row = record(key, layer, kind, [vec(v) for v in e.vertices_in_wcs()],
                             [float(e.dxf.const_width)*factor] + [v[i]*factor for v in vertices for i in (2, 3)],
                             [v[4] for v in vertices] + list(e.dxf.extrusion), [bool(e.closed)])
            elif kind == "POLYLINE" and (e.is_2d_polyline or e.is_3d_polyline):
                vertices = list(e.vertices)
                row = record(key, layer, kind, [vec(v) for v in e.points_in_wcs()],
                             [v.dxf.get(k, 0)*factor for v in vertices for k in ("start_width", "end_width")],
                             [v.dxf.get("bulge", 0) for v in vertices] + list(e.dxf.extrusion),
                             [bool(e.is_closed), bool(e.is_3d_polyline)])
            elif kind in ("CIRCLE", "ARC"):
                points = [vec(e.ocs().to_wcs(e.dxf.center))]
                params = list(e.dxf.extrusion)
                if kind == "ARC":
                    points += [vec(e.start_point), vec(e.end_point)]
                    params += [e.dxf.start_angle, e.dxf.end_angle]
                row = record(key, layer, kind, points, [e.dxf.radius*factor], params)
            elif kind == "ELLIPSE":
                row = record(key, layer, kind, [vec(e.dxf.center), vec(e.dxf.major_axis)],
                             params=[e.dxf.ratio, e.dxf.start_param, e.dxf.end_param] + list(e.dxf.extrusion))
            else:
                raise GuardError("不支持的实体 %s" % kind)
            if not row["points"]:
                raise GuardError("空几何")
            if e.has_xdata("SITE_GUARD"):
                tags = e.get_xdata("SITE_GUARD")
                names = [tag.value for tag in tags if tag.code == 1000]
                if len(names) != 1: raise GuardError("几何稳定编号无效")
                row["id"] = names[0]
            rows.append(row)
        except Exception as ex:
            errors.append("%s [%s]：%s" % (key, layer, ex))

    for e in doc.modelspace():
        walk(e, e.dxf.handle or "virtual")
    if wanted:
        missing = wanted - set(selected_roots)
        if missing: errors.append("未找到指定图层实体：%s" % sorted(missing))
    if errors:
        raise GuardError("DXF几何未完整读取，禁止判为通过：" + "; ".join(errors[:20]))
    if not rows:
        raise GuardError("所选范围没有可校验几何，禁止空结果通过")
    return {"units": units, "insunits": code, "records": rows,
            "annotations_excluded": dict(annotations)}


def geometry_key(r):
    return digest({k: v for k, v in r.items() if k != "id"})


def compatible(a, b, tol):
    for k in ("layer", "kind", "flags"):
        if a[k] != b[k]: return False
    if any(len(a[k]) != len(b[k]) for k in ("points", "lengths", "params")): return False
    if any(math.dist(p, q) > tol for p, q in zip(a["points"], b["points"])): return False
    if any(abs(x-y) > tol for x, y in zip(a["lengths"], b["lengths"])): return False
    if any(abs(x-y) > 1e-10 for x, y in zip(a["params"], b["params"])): return False
    return True


def compare_records(before, after, tol, by_id=False):
    tol = tolerance(tol)
    issues = []
    if by_id:
        a, b = {r["id"]: r for r in before}, {r["id"]: r for r in after}
        if len(a) != len(before) or len(b) != len(after):
            raise GuardError("稳定编号重复，无法进行几何比对")
        for key in sorted(set(a) | set(b)):
            if key not in a or key not in b:
                issues.append({"id": key, "reason": "几何新增/缺失"})
            elif not compatible(a[key], b[key], tol):
                delta = max((math.dist(p, q) for p, q in zip(a[key]["points"], b[key]["points"])), default=0)
                issues.append({"id": key, "reason": "坐标/尺寸/形状/类型变化", "max_paired_point_delta_m": delta})
    else:
        # Exact multiset elimination is O(n); tolerant matching only processes leftovers.
        pool = defaultdict(list)
        for r in after: pool[geometry_key(r)].append(r)
        unmatched = []
        for r in before:
            hit = pool.get(geometry_key(r))
            if hit: hit.pop()
            else: unmatched.append(r)
        remaining = [r for group in pool.values() for r in group]
        for r in unmatched:
            found = next((i for i, s in enumerate(remaining) if compatible(r, s, tol)), None)
            if found is None: issues.append({"id": r["id"], "layer": r["layer"], "reason": "原几何缺失或变化"})
            else: remaining.pop(found)
        issues += [{"id": r["id"], "layer": r["layer"], "reason": "新增或无法对应的几何"} for r in remaining]
    return {"passed": not issues, "before_count": len(before), "after_count": len(after),
            "tolerance_m": tol, "issues": issues}


def freeze_dxf(source, manifest, units, layers, tol):
    manifest = Path(manifest)
    if manifest.exists(): raise GuardError("已有冻结清单不可覆盖，请使用新版本路径")
    source_sha = file_hash(source)
    snap = dxf_snapshot(ezdxf.readfile(source), units, layers)
    if file_hash(source) != source_sha: raise GuardError("读取期间源文件改变")
    snap.update(version=VERSION, kind="dxf", source_name=Path(source).name,
                source_sha256=source_sha, layers=list(layers), tolerance_m=tolerance(tol))
    frozen = manifest.with_suffix(".source.dxf")
    if frozen.exists(): raise GuardError("已有冻结源文件不可覆盖")
    frozen.parent.mkdir(parents=True, exist_ok=True)
    shutil.copy2(source, frozen); frozen.chmod(0o444)
    if file_hash(frozen) != source_sha: raise GuardError("复制期间源文件改变，须检查并另建基准版本")
    snap["frozen_source"] = frozen.name
    write_json(manifest, seal(snap), exclusive=True)
    return snap


def verify_dxf(manifest, candidate, report=None):
    base = load_baseline(manifest)
    if base["kind"] != "dxf": raise GuardError("须使用DXF冻结清单")
    frozen = Path(manifest).parent / base["frozen_source"]
    if file_hash(frozen) != base["source_sha256"]: raise GuardError("冻结源副本发生变化")
    snap = dxf_snapshot(ezdxf.readfile(candidate), base["units"], base["layers"])
    result = compare_records(base["records"], snap["records"], base["tolerance_m"])
    if snap["insunits"] != base["insunits"]:
        result["issues"].append({"reason": "$INSUNITS改变", "before": base["insunits"], "after": snap["insunits"]})
        result["passed"] = False
    result.update(version=VERSION, candidate_sha256=file_hash(candidate),
                  scope=base["layers"], annotations_excluded=snap["annotations_excluded"])
    if report: write_json(report, result)
    return result


def add_shape(rows, key, layer, geom, z=0):
    if geom is None or geom.is_empty: return
    if not geom.is_valid: raise GuardError("%s：无效几何，禁止自动修复后冻结" % key)
    if hasattr(geom, "geoms"):
        for i, g in enumerate(geom.geoms): add_shape(rows, "%s/%s" % (key, i), layer, g, z)
    elif geom.geom_type == "Polygon":
        rows.append(record(key+"/outer", layer, "LWPOLYLINE", [list(p[:2])+[z] for p in geom.exterior.coords],
                           [0.0] * (1 + 2*len(geom.exterior.coords)), [0.0]*len(geom.exterior.coords)+[0,0,1], [True]))
        for i, ring in enumerate(geom.interiors):
            rows.append(record(key+"/hole/%s" % i, layer, "LWPOLYLINE", [list(p[:2])+[z] for p in ring.coords],
                               [0.0]*(1+2*len(ring.coords)), [0.0]*len(ring.coords)+[0,0,1], [True]))
    elif geom.geom_type == "LineString":
        rows.append(record(key, layer, "line", [list(p[:2])+[z] for p in geom.coords]))
    elif geom.geom_type == "Point":
        rows.append(record(key, layer, "POINT", [[geom.x, geom.y, z]]))
    else: raise GuardError("%s：未覆盖的模型几何类型%s" % (key, geom.geom_type))


def model_records(M, protected_ids=None, all_design=False):
    rows = []
    add_shape(rows, "redline", "redline", M.redline)
    for name in ("banks", "ponds", "roads"):
        for i, geom in enumerate(getattr(M, name)): add_shape(rows, "%s/%s" % (name, i), name, geom)
    add_shape(rows, "channel", "channel", M.channel)
    for e in M.existing: add_shape(rows, "existing/"+e["id"], "existing", e["_g"])
    for i, (z, geom) in enumerate(M.contours): add_shape(rows, "contour/%s" % i, "contour", geom, z)
    for i, p in enumerate(M.spots): rows.append(record("spot/%s" % i, "spot", "POINT", [p]))
    ids = set(protected_ids or [])
    found = set()
    for b in M.buildings:
        if all_design or b["id"] in ids:
            if b["id"] in found: raise GuardError("建筑编号重复：%s" % b["id"])
            found.add(b["id"])
            if b["_g"] is None:
                rows.append(record("building/"+b["id"], "building", "unplaced"))
            else: add_shape(rows, "building/"+b["id"], "building", b["_g"])
    if ids - found: raise GuardError("冻结建筑编号缺失：%s" % sorted(ids-found))
    if all_design:
        for i, br in enumerate(M.bridges): add_shape(rows, "bridge/%s" % i, "bridge", br["_g"])
        for key, geom in M.lines_.items(): add_shape(rows, "line/"+key, "line", geom)
    return rows


def source_paths(M):
    return {key: Path(M.dir) / s["file"] for key, s in M.m["sources"].items()}


def check_reader_scope(M):
    """The legacy SiteModel reader is narrower than the DXF snapshot reader."""
    selections = []
    for key in ("redline", "water", "roads", "existing"):
        cfg = M.m.get(key, {})
        defaults = {"redline": None, "water": "SXSS", "roads": "DLSS", "existing": "JMD"}
        layer = cfg.get("layer", defaults[key])
        if cfg and layer and "coords" not in cfg:
            selections.append((cfg.get("source", M.m["redline"].get("source", "base") if key == "water" else "base"), layer))
    for cfg in M.m.get("existing", {}).get("extra", []):
        selections.append((cfg["source"], cfg.get("layer", "JMD")))
    for b in M.m.get("buildings", []):
        cfg = b.get("geom") or {}
        if cfg.get("type") == "existing": selections.append((cfg["source"], cfg.get("layer", "JMD")))
    for src, layer in selections:
        for e in M.src[src].msp:
            if e.dxf.layer != layer or e.dxftype() in ANNOTATIONS: continue
            kind = e.dxftype()
            if kind not in ("LINE", "LWPOLYLINE", "POLYLINE", "POINT"):
                raise GuardError("SiteModel底图读取未覆盖%s层的%s；须先制作并核验展开/转换副本" % (layer, kind))
            if kind == "LWPOLYLINE" and any(p[4] for p in e.get_points()):
                raise GuardError("SiteModel不保留多段线弧段：%s；须先核验离散化副本" % layer)
            if kind == "POLYLINE" and (not (e.is_2d_polyline or e.is_3d_polyline) or any(v.dxf.get("bulge", 0) for v in e.vertices)):
                raise GuardError("SiteModel未覆盖网格或弧段：%s" % layer)
            if tuple(e.dxf.get("extrusion", (0, 0, 1))) != (0, 0, 1):
                raise GuardError("SiteModel未覆盖非默认OCS：%s" % layer)
            if kind in ("LWPOLYLINE", "POLYLINE"):
                closed = e.closed if kind == "LWPOLYLINE" else e.is_closed
                if closed:
                    from shapely.geometry import Polygon
                    points = list(e.vertices_in_wcs() if kind == "LWPOLYLINE" else e.points_in_wcs())
                    if len(points) < 3 or not Polygon([(p[0],p[1]) for p in points]).is_valid:
                        raise GuardError("源轮廓无效，禁止将自动修复后的形状直接冻结：%s" % layer)


def freeze_model(M, directory, protected_ids, tol):
    """Explicit operation only; registers a new baseline in the user's model."""
    directory = Path(directory).resolve()
    if directory.exists(): raise GuardError("冻结目录已存在，须另建版本；禁止覆盖基准")
    check_reader_scope(M)
    paths = source_paths(M)
    for key, src in M.src.items():
        if file_hash(paths[key]) != src.file_sha256_at_read:
            raise GuardError("底图已在模型读取后改变：%s；先重新加载并核对" % key)
        # This planning engine works in metres and does not convert drawing units.
        declared = M.m["sources"][key].get("units")
        code = int(src.doc.header.get("$INSUNITS", 0))
        if code != 6 and not (code == 0 and declared == "m"):
            raise GuardError("数据源%s须为米制；无单位文件须在sources中显式声明units=m。先核实转换副本，不得只改单位标签" % key)
    rows = model_records(M, protected_ids)
    data = {"version": VERSION, "kind": "model", "tolerance_m": tolerance(tol),
            "protected_buildings": list(protected_ids), "records": rows,
            "source_config": copy.deepcopy(M.m["sources"]), "cm": M.project.get("cm"),
            "sources": {key: {"sha256": file_hash(p), "copy": "source_%s.dxf" % i}
                        for i, (key, p) in enumerate(paths.items())}}
    directory.mkdir(parents=True)
    for key, p in paths.items():
        dest = directory / data["sources"][key]["copy"]
        shutil.copy2(p, dest); dest.chmod(0o444)
        if file_hash(dest) != data["sources"][key]["sha256"]:
            raise GuardError("复制期间底图改变，冻结未完成")
    manifest = directory / "freeze.json"
    write_json(manifest, seal(data), exclusive=True)
    shutil.copy2(M.path, directory / "model_before_freeze.json")
    M.m["geometry_guard"] = {"version": VERSION, "manifest": os.path.relpath(manifest, Path(M.dir).resolve()),
                             "sha256": file_hash(manifest)}
    write_json(M.path, M.m)
    return manifest


def preflight(M):
    config = M.m.get("geometry_guard")
    if not config:
        raise GuardError("未建立底图冻结基准。先核对米制底图与保护范围，再显式运行freeze；旧项目不会自动判为通过")
    if config.get("version") != VERSION or not config.get("sha256"):
        raise GuardError("冻结引用缺少版本或指纹")
    manifest = Path(M.dir) / config["manifest"]
    base = load_baseline(manifest, config.get("sha256"))
    if base["kind"] != "model": raise GuardError("模型引用的冻结清单类型错误")
    if base["source_config"] != M.m["sources"] or base["cm"] != M.m.get("project", {}).get("cm"):
        raise GuardError("底图来源、单位声明或坐标变换设置改变")
    for key, src in base["sources"].items():
        if file_hash(source_paths(M)[key]) != src["sha256"]:
            raise GuardError("原始底图已变化：%s" % key)
        if file_hash(manifest.parent / src["copy"]) != src["sha256"]:
            raise GuardError("冻结底图副本已变化：%s" % key)
        if M.src[key].file_sha256_at_read != src["sha256"]:
            raise GuardError("内存底图与冻结文件版本不一致：%s" % key)
    result = compare_records(base["records"], model_records(M, base["protected_buildings"]), base["tolerance_m"], by_id=True)
    if not result["passed"]: raise GuardError("受保护几何改变：%s" % result["issues"][:10])
    return base


def generation_state(M):
    base = preflight(M)
    if digest(json.loads(Path(M.path).read_text(encoding="utf-8"))) != digest(M.m):
        raise GuardError("内存模型与已保存模型不一致；先保存设计版本并重新加载")
    specs = {b["id"]: b for b in M.m.get("buildings", [])}
    if len(specs) != len(M.m.get("buildings", [])) or len(M.buildings) != len(specs):
        raise GuardError("模型建筑编号重复或缓存数量不一致")
    for b in M.buildings:
        spec = specs.get(b["id"])
        if spec != {k: v for k, v in b.items() if k != "_g"}:
            raise GuardError("建筑属性缓存与模型不一致：%s" % b["id"])
        wanted, actual = [], []
        add_shape(wanted, b["id"], "building", M.geom(spec.get("geom")))
        add_shape(actual, b["id"], "building", b["_g"])
        if not compare_records(wanted, actual, base["tolerance_m"], by_id=True)["passed"]:
            raise GuardError("建筑几何缓存与模型不一致：%s" % b["id"])
    return {"rows": model_records(M, all_design=True), "model": digest(M.m),
            "file": file_hash(M.path), "tolerance_m": base["tolerance_m"]}


def check_generation(M, before):
    preflight(M)
    result = compare_records(before["rows"], model_records(M, all_design=True), before["tolerance_m"], by_id=True)
    if digest(M.m) != before["model"] or file_hash(M.path) != before["file"]:
        result["issues"].append({"reason": "生成期间模型数据/文件发生改变"}); result["passed"] = False
    if not result["passed"]: raise GuardError("生成前后几何或模型不一致：%s" % result["issues"][:10])
    return result


def ensure_output_path(M, path):
    path = Path(path).resolve()
    config = M.m.get("geometry_guard")
    if not config: raise GuardError("未建立冻结基准")
    frozen_dir = (Path(M.dir) / config["manifest"]).resolve().parent
    if (path == Path(M.path).resolve() or path in [p.resolve() for p in source_paths(M).values()]
            or path == frozen_dir or frozen_dir in path.parents):
        raise GuardError("输出不得覆盖模型、原始底图或冻结基准目录")


def guarded_file(M, out, writer):
    """Generation gate for images/HTML/XLSX; does not certify raster dimensions."""
    before = generation_state(M)
    ensure_output_path(M, out)
    out = Path(out).resolve(); out.parent.mkdir(parents=True, exist_ok=True)
    with tempfile.TemporaryDirectory(prefix=".geometry-stage-", dir=out.parent) as work:
        pending = Path(work) / out.name
        value = writer(str(pending))
        result = check_generation(M, before)
        if not pending.is_file(): raise GuardError("生成器没有写出预期成果")
        result.update(version=VERSION, scope="源文件及模型生成前后；未对栅格图/排版进行尺寸认证", output_sha256=file_hash(pending))
        os.replace(pending, out)
        write_json(str(out)+".geometry-check.json", result)
        if value == str(pending): value = str(out)
    return value


def guard_output(writer):
    @wraps(writer)
    def wrapped(M, out, *args, **kwargs):
        return guarded_file(M, out, lambda pending: writer(M, pending, *args, **kwargs))
    return wrapped


def core_export_records(M, layers):
    """Independent model-to-export check, including holes and per-building IDs."""
    rows = []
    add_shape(rows, "redline", layers["red"], M.redline)
    for b in M.buildings:
        add_shape(rows, "building/"+b["id"], layers["cat:"+b["cat"]], b["_g"])
    for e in M.existing:
        add_shape(rows, "existing/"+e["id"], layers["demo"] if e["action"] == "拆除" else layers["keep"], e["_g"])
    for i, br in enumerate(M.bridges): add_shape(rows, "bridge/%s" % i, layers["bridge"], br["_g"])
    return rows


def checked_save_dxf(doc, out, M, layers, before):
    """Only publish after model comparison, disk readback, audit and unit checks."""
    out = Path(out).resolve(); out.parent.mkdir(parents=True, exist_ok=True)
    ensure_output_path(M, out)
    snap = dxf_snapshot(doc, "m")
    expected = core_export_records(M, layers)
    core_layers = {layers[k] for k in layers if k in ("red", "keep", "demo", "bridge") or k.startswith("cat:")}
    core = compare_records(expected, [r for r in snap["records"] if r["layer"] in core_layers], before["tolerance_m"], by_id=True)
    if not core["passed"]: raise GuardError("导出图元与模型边界不一致：%s" % core["issues"][:10])
    fd, tmp = tempfile.mkstemp(prefix=".geometry-check-", suffix=".dxf", dir=out.parent)
    os.close(fd)
    try:
        doc.saveas(tmp)
        reread = ezdxf.readfile(tmp)
        audit = reread.audit()
        if audit.has_errors or audit.has_fixes: raise GuardError("DXF回读审计发现错误或自动修复，禁止发布")
        after = dxf_snapshot(reread, "m")
        result = compare_records(snap["records"], after["records"], before["tolerance_m"])
        reread_core = compare_records(expected, [r for r in after["records"] if r["layer"] in core_layers], before["tolerance_m"], by_id=True)
        if not reread_core["passed"]: raise GuardError("DXF回读稳定编号或模型边界丢失")
        if after["insunits"] != 6: raise GuardError("导出DXF未明确声明米制")
        if not result["passed"]: raise GuardError("DXF落盘回读几何不一致：%s" % result["issues"][:10])
        generation = check_generation(M, before)
        result.update(version=VERSION, scope="全部输出几何回读；红线/建筑/现状/桥另与模型比对", core_model_check=core,
                      generation_check=generation, insunits=6, output_sha256=file_hash(tmp),
                      annotations_excluded=after["annotations_excluded"])
        # Failure never replaces an existing deliverable.
        os.replace(tmp, out)
        write_json(str(out)+".geometry-check.json", result)
        return result
    finally:
        if os.path.exists(tmp): os.unlink(tmp)

# -*- coding: utf-8 -*-
"""
site_render.py — 出图模块（全部由 SiteModel 驱动，面板数字自动计算，不手填）

render_base     工序0 精确底盘（红线/等高线/高程点/水系/道路/现状建筑）
render_ledger   工序1 现状台账图（E编号 + 留改拆着色 + 台账表）——与甲方对齐留拆的"共同锚点"
render_terrain  工序1 坡度分级 + 剖面（识别可建平台/陡坡景观资源）
render_plan     工序4-6 总平面：style = aman | yetai | traffic
                 panel = metrics | schedule | zone | None；zoom/zone 出分区图则

默认出图规格：
- Aman 黑白灰：炭灰建筑、阴影只落地(平移后减去全部建筑)、屋面细缝肌理(沿长轴平行细线,不画脊线)
- 景观：留白 + 有形竹屏 + 孤植乔木(逐株校验不进水/不上路/不压房) ；绝不满铺竹点
- 溪流保持本色；退让带不涂色盖溪；红线美化版用深灰，技术版用红
- 投影可读：全图 18.5×14in、面板 0.398 宽、正文≥10.5pt、编号≥9.6pt 加描边
- 分区图则：编号文字 clip_on=True（否则溢出压到右侧面板）
