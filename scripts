def _find_font(bold):
    cands = (["/usr/share/fonts/opentype/noto/NotoSansCJK-Bold.ttc"] if bold else ["/usr/share/fonts/opentype/noto/NotoSansCJK-Regular.ttc"]) + [
        "/System/Library/Fonts/PingFang.ttc", "/System/Library/Fonts/STHeiti Medium.ttc",
        "/System/Library/Fonts/Supplemental/Songti.ttc", "/Library/Fonts/Arial Unicode.ttf",
        "C:/Windows/Fonts/msyhbd.ttc" if bold else "C:/Windows/Fonts/msyh.ttc", "C:/Windows/Fonts/simhei.ttf"]
    for c in cands:
        if os.path.exists(c): return c
    for f in fm.findSystemFonts():
        if any(k in os.path.basename(f) for k in ("CJK", "PingFang", "Hei", "Song", "YaHei", "Noto Sans SC")): return f
    return None
_FB, _FR = _find_font(True), _find_font(False)
ZB = fm.FontProperties(fname=_FB) if _FB else fm.FontProperties(weight="bold")
ZR = fm.FontProperties(fname=_FR) if _FR else fm.FontProperties()

