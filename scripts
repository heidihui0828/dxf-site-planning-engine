function pt(ev){const m=svg.getScreenCTM().inverse();const P=svg.createSVGPoint();P.x=ev.clientX;P.y=ev.clientY;const q=P.matrixTransform(m);return [q.x/C.S+C.X0,C.Y1-q.y/C.S];}
