"""Behavioral regression tests using synthetic, non-client DXF geometry."""
import copy
import json
import math
import os
from pathlib import Path
import subprocess
import sys
import tempfile
import unittest
from unittest.mock import patch

sys.path.insert(0, str(Path(__file__).resolve().parents[1]))
import ezdxf
from ezdxf.math import Matrix44
from site_engine import SiteModel, zone_prefix_of
from site_export import export_dxf
from site_guard import (GuardError, freeze_dxf, verify_dxf, freeze_model, preflight,
                        generation_state, check_generation, file_hash, dxf_snapshot,
                        compare_records, guarded_file, write_json)


class GeometryGuardTests(unittest.TestCase):
    def setUp(self):
        self.temp = tempfile.TemporaryDirectory()
        self.root = Path(self.temp.name)
        self.src = self.root / "source.dxf"
        doc = ezdxf.new("R2010"); doc.units = 6
        doc.layers.new("BOUNDARY"); doc.layers.new("EXISTING")
        doc.modelspace().add_lwpolyline([(0,0),(80,0),(80,60),(0,60)], close=True, dxfattribs={"layer":"BOUNDARY"})
        doc.modelspace().add_lwpolyline([(5,5),(15,5),(15,13),(5,13)], close=True, dxfattribs={"layer":"EXISTING"})
        doc.saveas(self.src)
        self.manifest = self.root / "base.json"
        freeze_dxf(self.src, self.manifest, "m", ["EXISTING"], .001)

    def tearDown(self):
        self.temp.cleanup()

    def change(self, fn):
        doc = ezdxf.readfile(self.src); fn(doc)
        target = self.root / "candidate.dxf"; doc.saveas(target)
        return target

    def entity(self, doc):
        return doc.modelspace().query('LWPOLYLINE[layer=="EXISTING"]')[0]

    def model(self):
        data = {"project":{"name":"Synthetic guard fixture", "cm":None},
                "sources":{"base":{"file":"source.dxf", "units":"m"}},
                "redline":{"source":"base", "layer":"BOUNDARY"},
                "existing":{"source":"base", "layer":"EXISTING", "min_area":1, "default_action":"保留"},
                "categories":{"test":{"label":"test", "color":"#555555"}},
                "buildings":[{"id":"01", "name":"Fixed", "cat":"test", "kind":"现状改造", "floors":1,
                              "geom":{"type":"poly", "coords":[[20,20],[30,20],[30,26],[25,26],[25,30],[20,30]]}},
                             {"id":"02", "name":"Design", "cat":"test", "kind":"新建", "floors":1,
                              "geom":{"type":"rect", "cx":50,"cy":30,"w":10,"h":8,"rot":0}}],
                "controls":{}}
        path = self.root / "model.json"; write_json(path, data)
        M = SiteModel(path)
        freeze_model(M, self.root / "frozen", ["01"], .001)
        return SiteModel(path)

    def test_unchanged_roundtrip_passes(self):
        candidate = self.change(lambda d: None)
        self.assertTrue(verify_dxf(self.manifest, candidate)["passed"])

    def test_handles_may_change(self):
        def change(d):
            old = self.entity(d); pts = list(old.get_points()); d.modelspace().delete_entity(old)
            d.modelspace().add_lwpolyline(pts, close=True, dxfattribs={"layer":"EXISTING"})
        self.assertTrue(verify_dxf(self.manifest, self.change(change))["passed"])

    def test_same_area_nonuniform_scale_is_detected(self):
        target = self.change(lambda d: self.entity(d).transform(Matrix44.scale(2, .5, 1)))
        self.assertFalse(verify_dxf(self.manifest, target)["passed"])

    def test_translation_rotation_mirror_height_detected(self):
        for transform in [Matrix44.translate(.1,0,0), Matrix44.z_rotate(.1), Matrix44.scale(-1,1,1), Matrix44.translate(0,0,.1)]:
            with self.subTest(transform=transform):
                target = self.change(lambda d: self.entity(d).transform(transform))
                self.assertFalse(verify_dxf(self.manifest, target)["passed"])

    def test_under_tolerance_passes(self):
        target = self.change(lambda d: self.entity(d).translate(.0001,0,0))
        self.assertTrue(verify_dxf(self.manifest, target)["passed"])

    def test_units_mismatch_stops(self):
        target = self.change(lambda d: setattr(d, "units", 4))
        with self.assertRaises(GuardError): verify_dxf(self.manifest, target)

    def test_missing_duplicate_and_layer_change_fail(self):
        for action in [lambda d: d.modelspace().delete_entity(self.entity(d)),
                       lambda d: d.modelspace().add_entity(self.entity(d).copy()),
                       lambda d: setattr(self.entity(d).dxf, "layer", "BOUNDARY")]:
            target = self.change(action)
            try: passed = verify_dxf(self.manifest, target)["passed"]
            except GuardError: passed = False
            self.assertFalse(passed)

    def test_unselected_new_design_allowed(self):
        target = self.change(lambda d: d.modelspace().add_line((1,1),(2,2), dxfattribs={"layer":"NEW"}))
        self.assertTrue(verify_dxf(self.manifest, target)["passed"])

    def test_unsupported_geometry_fails_closed(self):
        target = self.change(lambda d: d.modelspace().add_spline([(0,0),(1,2),(3,4)], dxfattribs={"layer":"EXISTING"}))
        with self.assertRaises(GuardError): verify_dxf(self.manifest, target)

    def test_baseline_cannot_be_overwritten_or_tampered(self):
        with self.assertRaises(GuardError): freeze_dxf(self.src,self.manifest,"m",["EXISTING"],.001)
        data = json.loads(self.manifest.read_text()); data["tolerance_m"] = 20
        write_json(self.manifest, data)
        with self.assertRaises(GuardError): verify_dxf(self.manifest,self.src)

    def test_nested_block_transform_is_measured(self):
        doc = ezdxf.new(); doc.units=6
        inner = doc.blocks.new("INNER"); inner.add_line((0,0),(10,0))
        outer = doc.blocks.new("OUTER"); outer.add_blockref("INNER",(2,3))
        doc.modelspace().add_blockref("OUTER",(30,40),dxfattribs={"layer":"BASE", "xscale":2,"yscale":3})
        rows=dxf_snapshot(doc,"m",["BASE"])["records"]
        self.assertEqual(len(rows),1)
        self.assertEqual(rows[0]["points"],[[34.,49.,0.],[54.,49.,0.]])
        doc.modelspace().query("INSERT")[0].dxf.xscale=3
        other=dxf_snapshot(doc,"m",["BASE"])["records"]
        self.assertFalse(compare_records(rows,other,.001)["passed"])

    def test_bulge_and_curve_change_detected(self):
        doc=ezdxf.new();doc.units=6
        e=doc.modelspace().add_lwpolyline([(0,0,0,0,.5),(10,0,0,0,0)],dxfattribs={"layer":"BASE"})
        before=dxf_snapshot(doc,"m",["BASE"])["records"]
        e.set_points([(0,0,0,0,.2),(10,0,0,0,0)])
        self.assertFalse(compare_records(before,dxf_snapshot(doc,"m",["BASE"])["records"],.001)["passed"])

    def test_model_freeze_and_export_pass(self):
        M=self.model();preflight(M)
        out=self.root/'proposal.dxf';export_dxf(M,out)
        doc=ezdxf.readfile(out);self.assertEqual(doc.units,6)
        report=json.loads(Path(str(out)+'.geometry-check.json').read_text())
        self.assertTrue(report['passed']);self.assertTrue(report['core_model_check']['passed'])
        self.assertEqual(report['output_sha256'],file_hash(out))

    def test_missing_freeze_blocks_export(self):
        M=self.model();M.m.pop('geometry_guard')
        with self.assertRaises(GuardError):export_dxf(M,self.root/'bad.dxf')
        self.assertFalse((self.root/'bad.dxf').exists())

    def test_frozen_source_change_blocks(self):
        M=self.model()
        with self.src.open('a') as f:f.write('\n')
        with self.assertRaises(GuardError):preflight(M)

    def test_protected_geometry_edit_blocks(self):
        M=self.model();data=json.loads(Path(M.path).read_text())
        data['buildings'][0]['geom']['coords'][0][0]+=1
        write_json(M.path,data)
        with self.assertRaises(GuardError):preflight(SiteModel(M.path))

    def test_unprotected_design_edit_allowed(self):
        M=self.model();data=json.loads(Path(M.path).read_text())
        data['buildings'][1]['geom']['w']=12;write_json(M.path,data)
        preflight(SiteModel(M.path))

    def test_generation_mutation_rejected_without_overwriting_old_output(self):
        M=self.model();out=self.root/'drawing.txt';out.write_text('old approved')
        def writer(path):
            Path(path).write_text('bad new')
            M.buildings[1]['_g']=M.buildings[1]['_g'].buffer(2)
        with self.assertRaises(GuardError):guarded_file(M,out,writer)
        self.assertEqual(out.read_text(),'old approved')

    def test_apply_cannot_change_frozen_or_nonrectangular_objects(self):
        M=self.model();old=file_hash(M.path)
        row={'id':'01','cx':25,'cy':25,'rot':0,'w':10,'h':10,'floors':1}
        with self.assertRaises(GuardError):M.apply_board([row])
        self.assertEqual(old,file_hash(M.path))

    def test_apply_design_preserves_precision(self):
        M=self.model();row={'id':'02','cx':50.123456,'cy':30,'rot':.012345,'w':10.123456,'h':8,'floors':1}
        M.apply_board([row]);data=json.loads(Path(M.path).read_text())
        self.assertEqual(data['buildings'][1]['geom']['w'],10.123456)
        preflight(SiteModel(M.path))

    def test_readback_corruption_does_not_publish(self):
        M=self.model();out=self.root/'proposal.dxf';out.write_text('prior approved artifact')
        original=ezdxf.readfile
        def broken(path,*args,**kwargs):
            doc=original(path,*args,**kwargs)
            if '.geometry-check-' in str(path):
                doc.modelspace().query('LWPOLYLINE[layer=="00-用地红线"]')[0].translate(1,0,0)
            return doc
        with patch('ezdxf.readfile',side_effect=broken):
            with self.assertRaises(GuardError):export_dxf(M,out)
        self.assertEqual(out.read_text(),'prior approved artifact')

    def test_cli_failure_returns_nonzero_and_report(self):
        target=self.change(lambda d:self.entity(d).translate(1,0,0))
        report=self.root/'report.json'
        result=subprocess.run([sys.executable,str(Path(__file__).resolve().parents[1]/'site_cli.py'),
                               'verify-dxf',str(self.manifest),str(target),'--report',str(report)],capture_output=True,text=True)
        self.assertEqual(result.returncode,2)
        self.assertFalse(json.loads(report.read_text())['passed'])

    def test_nan_tolerance_rejected(self):
        with self.assertRaises(GuardError):freeze_dxf(self.src,self.root/'new.json','m',['EXISTING'],float('nan'))

    def test_extmin_placeholder_is_not_a_coordinate_zone(self):
        self.assertEqual(zone_prefix_of(1e20),0)
        self.assertEqual(zone_prefix_of(float('inf')),0)
        self.assertEqual(zone_prefix_of(40512345.6),40)
        self.assertEqual(zone_prefix_of(12345.6),0)

    def test_generation_rejects_stale_in_memory_geometry(self):
        M=self.model();M.buildings[1]['_g']=M.buildings[1]['_g'].buffer(1)
        with self.assertRaises(GuardError):generation_state(M)

    def test_nonrectangular_unprotected_object_cannot_be_replaced(self):
        M=self.model();data=json.loads(Path(M.path).read_text())
        data['buildings'][1]['geom']={'type':'poly','coords':[[40,20],[50,20],[50,30],[40,28]]}
        write_json(M.path,data);M=SiteModel(M.path)
        with self.assertRaises(GuardError):M.apply_board([{'id':'02','cx':45,'cy':25,'rot':0,'w':10,'h':10}])

    def test_frozen_copy_change_is_detected(self):
        M=self.model();frozen=self.root/'frozen/source_0.dxf'
        frozen.chmod(0o644)
        with frozen.open('a') as f:f.write('\n')
        with self.assertRaises(GuardError):preflight(M)

    def test_output_cannot_overwrite_source(self):
        M=self.model();before=file_hash(self.src)
        with self.assertRaises(GuardError):guarded_file(M,self.src,lambda p:Path(p).write_text('bad'))
        self.assertEqual(before,file_hash(self.src))

    def test_missing_id_and_duplicate_id_in_model_block_generation(self):
        M=self.model();data=json.loads(Path(M.path).read_text());data['buildings'][0]['id']='03'
        write_json(M.path,data)
        with self.assertRaises(GuardError):generation_state(SiteModel(M.path))

    def test_meter_source_required_for_planning_engine(self):
        M=self.model();doc=ezdxf.readfile(self.src);doc.units=4;doc.saveas(self.src)
        M=SiteModel(M.path)
        with self.assertRaises(GuardError):freeze_model(M,self.root/'frozen2',['01'],.001)

    def test_failed_readback_units_do_not_publish(self):
        M=self.model();out=self.root/'bad.dxf';original=ezdxf.readfile
        def broken(path,*args,**kwargs):
            doc=original(path,*args,**kwargs)
            if '.geometry-check-' in str(path):doc.units=4
            return doc
        with patch('ezdxf.readfile',side_effect=broken):
            with self.assertRaises(GuardError):export_dxf(M,out)
        self.assertFalse(out.exists())

    def test_fixed_object_excluded_from_board(self):
        from site_board import make_board
        M=self.model();out=self.root/'board.html';make_board(M,str(out))
        txt=out.read_text();cfg=json.loads(txt.split('const C=',1)[1].split('; let B=',1)[0])
        self.assertEqual([b['id'] for b in cfg['blocks']],['02'])
        self.assertTrue(Path(str(out)+'.geometry-check.json').exists())

    def test_circles_arcs_and_3d_lines_survive_roundtrip(self):
        doc=ezdxf.new();doc.units=6;m=doc.modelspace()
        m.add_circle((3,4,5),radius=2)
        m.add_arc((7,8,9),radius=3,start_angle=10,end_angle=90)
        m.add_polyline3d([(0,0,3),(1,2,5),(5,6,9)])
        m.add_line((1,2,3),(4,5,6));m.add_point((2,3,4))
        path=self.root/'curves.dxf';doc.saveas(path)
        self.assertTrue(compare_records(dxf_snapshot(doc,'m')['records'],dxf_snapshot(ezdxf.readfile(path),'m')['records'],.001)['passed'])

    def test_polygon_hole_is_preserved_in_export(self):
        M=self.model();data=json.loads(Path(M.path).read_text())
        data['buildings'][1]['geom']={'type':'poly','coords':[[40,20],[60,20],[60,40],[40,40]],
                                     'holes':[[[45,25],[45,35],[55,35],[55,25]]]}
        write_json(M.path,data);M=SiteModel(M.path)
        out=self.root/'holes.dxf';export_dxf(M,out)
        rows=dxf_snapshot(ezdxf.readfile(out),'m')['records']
        self.assertEqual(len([r for r in rows if r['id'].startswith('building/02/')]),2)
        self.assertAlmostEqual(M.buildings[1]['_g'].area,300)

    def test_legacy_reader_rejects_unhandled_block_layer(self):
        M=self.model();doc=ezdxf.readfile(self.src);b=doc.blocks.new('extra')
        b.add_line((0,0),(1,1));doc.modelspace().add_blockref('extra',(1,1),dxfattribs={'layer':'EXISTING'});doc.saveas(self.src)
        with self.assertRaises(GuardError):freeze_model(SiteModel(M.path),self.root/'blocked',['01'],.001)


if __name__ == '__main__':unittest.main(verbosity=2)
